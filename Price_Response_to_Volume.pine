//@version=6

// Revision: 2.9

indicator("Price Response to Volume v2", shorttitle="Price Response Vol v2", overlay=false)

// ============================================================================

// HANDOFF / NEXT-THREAD SPEC

// ============================================================================

// PURPOSE

// Measure how efficiently price moves relative to trading participation.

//

// CORE MEASURES

// Relative Range = Current High-Low / Median prior comparable High-Low range.

// RVOL           = Current Volume / Typical prior comparable Volume.

// Neutral Response = Relative Range / RVOL.

// Body Efficiency  = (Close-Open) / max(High-Low, min tick).

// Directional Response = Neutral Response * Body Efficiency.

//

// INTERPRETATION

// Neutral Response < 1:

//   Volume expanded more than range. More effort, less result. Base/resistance-like.

// Neutral Response > 1:

//   Range expanded more than volume. Price moves easily. Leg/expansion-like.

//

// Directional Response:

//   Positive = Rally response.

//   Negative = Drop response.

//   Near zero = poor directional progress / wick-heavy churn.

//

// AUTOMATIC TIMEFRAME MODE

// A) Any time-based intraday chart timeframe below 1D:

//    Use the chart's native candle and compare its range and volume only with prior

//    candles that started at the SAME exchange-time slot on that same timeframe.

//    Example: a 09:30 196m bar compares only with prior 09:30 196m bars.

//    No intraday timeframe list is hardcoded and no synthetic aggregation is used.

//

// B) Chart timeframe >= Daily:

//    Slot identity disappears. Each bar compares with prior bars from the same native

//    chart timeframe. There is no special higher-timeframe display feature.

//

// LOOKBACK MODE

// Fixed:

//    Uses exactly Fixed Lookback Periods on every supported timeframe.

//

// Adaptive:

//    Quarterly (~3 Months): intraday same-slot = 63 observations; Daily-or-higher

//    maps that horizon to the active native timeframe with a minimum statistical population.

//    Structural (~6 Months): same idea using approximately two quarterly cycles.

//

// VOLUME BASELINE

// Average = classic RVOL denominator.

// Median  = more resistant to isolated giant volume spikes.

//

// RANGE BASELINE

// Always Median because event candles can heavily distort an average range.

//

// SIGNAL DOTS

// Green dot  = Efficient Rally: confirmed Directional Response >= Strong Directional threshold.

//              Price advanced efficiently relative to participation and candle structure.

// Red dot    = Efficient Drop: confirmed Directional Response <= negative Strong Directional threshold.

//              Price declined efficiently relative to participation and candle structure.

// Orange dot = Resistant Response: confirmed Neutral Response <= Low Neutral Response threshold.

//              Participation is high relative to range produced; base/resistance-like behavior.

// Green stays at pane top. Red and orange stay at pane bottom. Their vertical placement is

// pane-relative, so resizing the indicator scale does not shift their visual anchor.

//

// ALERTS

// Efficient Rally (Green Dot): confirmed green-dot condition.

// Efficient Drop (Red Dot): confirmed red-dot condition.

// Efficient Rally or Drop (Green/Red Dot): either directional dot condition.

// Resistant Response (Orange Dot): confirmed orange-dot condition.

// Signed Body Efficiency Cross Above 0: confirmed body efficiency crosses from <=0 to >0.

// Signed Body Efficiency Cross Below 0: confirmed body efficiency crosses from >=0 to <0.

// Existing alert conditions are preserved; only their titles/messages are clarified.

//

// PINE SCREENER OUTPUTS

// No chart table is required. Pine Screener consumes plot() values and alertcondition() events.

// The first ten plots are intentionally screener-friendly: core numerical measures, a Ready flag,

// and 1/0 flags for the green, red and orange signal dots. These plots are Data Window only,

// so they do not add visible lines to the indicator pane.

//

// DISPLAY / ALERT CONFIRMATION

// Main numerical response plots may update on the live realtime bar so the developing response

// remains visible before the bar closes. Historical bars remain stable because they are confirmed.

// Colored-dot signals and named alerts require barstate.isconfirmed. No clock fallback is used.

//

// COMPILE SAFETY

// Prefer one complete Pine statement per line. Avoid multiline chained ternaries,

// multiline function calls, multiline tuple assignments and multiline alerts.

// ============================================================================

// ── Lookback.

groupLookback = "Lookback"

lookbackMode = input.string("Adaptive", "Lookback Mode", options=["Fixed", "Adaptive"], group=groupLookback, tooltip="Fixed: uses exactly the same number of prior comparable observations on every supported timeframe. Use this for manual control or to reproduce an existing setup.\n\nAdaptive: automatically changes the comparison population with the active chart timeframe so intraday and Daily-or-higher bars use comparable market horizons. Recommended for normal use.")

fixedLookbackPeriods = input.int(30, "Fixed Lookback Periods", minval=10, maxval=250, group=groupLookback, tooltip="Used ONLY when Lookback Mode = Fixed.\n\nOn intraday charts, this many prior observations are kept separately for EACH same-start-time slot.\nOn Daily-or-higher charts, it means prior bars of the active chart timeframe.\n\nIgnored in Adaptive mode.")

adaptiveHorizon = input.string("Quarterly (~3 Months)", "Adaptive Horizon", options=["Quarterly (~3 Months)", "Structural (~6 Months)"], group=groupLookback, tooltip="Used ONLY in Adaptive mode.\n\nQuarterly (~3 Months): approximately one earnings / quarterly institutional-flow cycle. Uses 63 prior same-slot intraday observations and maps a comparable horizon to Daily-or-higher native bars. Recommended default.\n\nStructural (~6 Months): approximately two quarterly cycles using 126 prior same-slot intraday observations and a comparable Daily-or-higher horizon.\n\nVery high timeframes keep a minimum population for more stable normalization.")

// ── Logic.

groupLogic = "Response Logic"

volumeBaselineMethod = input.string("Average", "Volume Baseline", options=["Average", "Median"], group=groupLogic, tooltip="Average: classic RVOL. RVOL 1.0 means current volume equals the average of the comparison population.\n\nMedian: more robust when occasional earnings/rebalance spikes pull the average upward.\n\nRange always uses a median baseline.")

lowResponseThreshold = input.float(0.75, "Low Neutral Response", minval=0.05, maxval=5.0, step=0.05, group=groupLogic, tooltip="Neutral Response at or below this value is flagged as resistant behavior: participation is large relative to the range produced.\n\nDefault 0.75 means price range expanded only 75% as much as volume did, on a normalized basis.")

highDirectionalThreshold = input.float(1.25, "Strong Directional Response", minval=0.05, maxval=10.0, step=0.05, group=groupLogic, tooltip="Absolute Directional Response at or above this value is flagged as a strong Rally/Drop response.\n\nPositive values are Rally response. Negative values are Drop response.")

// ── Display.

groupDisplay = "Display"

showDirectionalResponse = input.bool(true, "Show Directional Response", group=groupDisplay, tooltip="Main plot. Neutral Response multiplied by signed Body Efficiency.\n\nPositive = Rally response.\nNegative = Drop response.\nNear zero = weak directional result / churn.")

showNeutralResponse = input.bool(false, "Show Neutral Response", group=groupDisplay, tooltip="Shows Relative Range / RVOL without direction. Below 1 means volume expanded more than range; above 1 means range expanded more than volume.")

showRelativeRange = input.bool(false, "Show Relative Range", group=groupDisplay, tooltip="Current High-Low divided by the median High-Low of the active comparison population.")

showRvol = input.bool(false, "Show RVOL", group=groupDisplay, tooltip="Current volume divided by the typical volume of the active comparison population.\n\n1.0 = normal volume.\n1.5 = 50% above normal.\n2.0 = twice normal.")

showBodyEfficiency = input.bool(false, "Show Signed Body Efficiency", group=groupDisplay, tooltip="(Close-Open)/(High-Low).\n\nNear +1 = clean Rally body.\nNear 0 = wick-heavy / poor net progress.\nNear -1 = clean Drop body.")

showThresholds = input.bool(true, "Show Response Thresholds", group=groupDisplay)

rallyColor = input.color(color.lime, "Rally Response Color", group=groupDisplay)

dropColor = input.color(color.red, "Drop Response Color", group=groupDisplay)

neutralColor = input.color(color.blue, "Neutral Response Color", group=groupDisplay)

rangeColor = input.color(color.orange, "Relative Range Color", group=groupDisplay)

rvolColor = input.color(color.purple, "RVOL Color", group=groupDisplay)

bodyColor = input.color(color.gray, "Body Efficiency Color", group=groupDisplay)

// ── Helpers.

f_median(array<float> values) =>

    int n = array.size(values)

    float med = na

    if n > 0

        array<float> sorted = array.copy(values)

        array.sort(sorted, order.ascending)

        int mid = int(math.floor(n * 0.5))

        if n % 2 == 1

            med := array.get(sorted, mid)

        else

            med := (array.get(sorted, mid - 1) + array.get(sorted, mid)) * 0.5

    med

f_average(array<float> values) =>

    float result = na

    if array.size(values) > 0

        result := array.avg(values)

    result

f_percent_rank(array<float> values, float currentValue) =>

    float result = na

    int n = array.size(values)

    if n > 0 and not na(currentValue)

        int atOrBelow = 0

        for i = 0 to n - 1

            float priorValue = array.get(values, i)

            if priorValue <= currentValue

                atOrBelow += 1

        result := 100.0 * atOrBelow / n

    result

f_push_capped(array<float> values, float value, int cap) =>

    array.push(values, value)

    if array.size(values) > cap

        array.shift(values)

f_min_stat_population(int value) =>

    int result = value

    if result < 10

        result := 10

    result

f_volume_baseline(array<float> values) =>

    float result = na

    if volumeBaselineMethod == "Median"

        result := f_median(values)

    else

        result := f_average(values)

    result

// ── Generic intraday same-slot history.

// Each map key is the candle's exchange-time start slot in seconds since midnight.

// Each slot owns prior range and volume histories for this chart timeframe.

type IntradayResponseSlot

    int key

    array<float> ranges

    array<float> volumes

f_get_response_slot(map<int, IntradayResponseSlot> slots, int slotKey) =>

    IntradayResponseSlot slot = na

    if slots.contains(slotKey)

        slot := slots.get(slotKey)

    else

        slot := IntradayResponseSlot.new(slotKey, array.new<float>(), array.new<float>())

        slots.put(slotKey, slot)

    slot

// ── Determine automatic mode.

float chartTfSeconds = timeframe.in_seconds(timeframe.period)

bool chartIsIntraday = timeframe.isintraday and not na(chartTfSeconds)

bool chartIsDailyOrHigher = timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly

if not chartIsIntraday and not chartIsDailyOrHigher

    runtime.error("Price Response to Volume v2: unsupported non-time-based chart timeframe.")

// ── Adaptive lookback mapping.

int effectiveLookback = fixedLookbackPeriods

if lookbackMode == "Adaptive"

    bool structural = adaptiveHorizon == "Structural (~6 Months)"

    int targetTradingDays = 63

    if structural

        targetTradingDays := 126

    if chartIsIntraday

        effectiveLookback := targetTradingDays

    else if timeframe.isdaily

        int dailyMultiplier = timeframe.multiplier

        effectiveLookback := int(math.ceil(targetTradingDays * 1.0 / dailyMultiplier))

        effectiveLookback := f_min_stat_population(effectiveLookback)

    else if timeframe.isweekly

        int targetWeeks = 13

        if structural

            targetWeeks := 26

        int weeklyMultiplier = timeframe.multiplier

        effectiveLookback := int(math.ceil(targetWeeks * 1.0 / weeklyMultiplier))

        effectiveLookback := f_min_stat_population(effectiveLookback)

    else if timeframe.ismonthly

        if structural

            effectiveLookback := 24

        else

            effectiveLookback := 12

// ── Calculate response from already-known baselines.

f_response(float rangePx, float volumeValue, float rangeBase, float volumeBase, float openValue, float closeValue) =>

    float relativeRange = na

    float rvol = na

    float neutralResponse = na

    float bodyEfficiency = na

    float directionalResponse = na

    if not na(rangeBase) and rangeBase > 0

        relativeRange := rangePx / rangeBase

    if not na(volumeBase) and volumeBase > 0

        rvol := volumeValue / volumeBase

    if not na(relativeRange) and not na(rvol) and rvol > 0

        neutralResponse := relativeRange / rvol

    float safeRange = math.max(rangePx, syminfo.mintick)

    bodyEfficiency := (closeValue - openValue) / safeRange

    if not na(neutralResponse)

        directionalResponse := neutralResponse * bodyEfficiency

    [relativeRange, rvol, neutralResponse, bodyEfficiency, directionalResponse]

// ── Native intraday same-start-slot engine.

// Baselines use PRIOR same-slot observations only. The current candle is added only

// after confirmation, which keeps historical/replay values stable after bar close.

var map<int, IntradayResponseSlot> intradaySlots = map.new<int, IntradayResponseSlot>()

int iPopSize = 0

float iRelativeRange = na

float iRvol = na

float iNeutralResponse = na

float iBodyEfficiency = na

float iDirectionalResponse = na

float iVolumePercentile = na

if chartIsIntraday

    int iSlotKey = hour(time) * 3600 + minute(time) * 60 + second(time)

    IntradayResponseSlot iSlot = f_get_response_slot(intradaySlots, iSlotKey)

    float iRangePx = high - low

    iPopSize := array.size(iSlot.ranges)

    float iRangeBase = f_median(iSlot.ranges)

    float iVolumeBase = f_volume_baseline(iSlot.volumes)

    iVolumePercentile := f_percent_rank(iSlot.volumes, volume)

    [localRelativeRange, localRvol, localNeutralResponse, localBodyEfficiency, localDirectionalResponse] = f_response(iRangePx, volume, iRangeBase, iVolumeBase, open, close)

    iRelativeRange := localRelativeRange

    iRvol := localRvol

    iNeutralResponse := localNeutralResponse

    iBodyEfficiency := localBodyEfficiency

    iDirectionalResponse := localDirectionalResponse

    if barstate.isconfirmed

        f_push_capped(iSlot.ranges, iRangePx, effectiveLookback)

        f_push_capped(iSlot.volumes, volume, effectiveLookback)

// ── Daily-or-higher native engine.

f_rollup_engine(int populationCap) =>

    var array<float> ranges = array.new_float()

    var array<float> volumes = array.new_float()

    float rangePx = high - low

    int popSize = array.size(ranges)

    float rangeBase = f_median(ranges)

    float volumeBase = f_volume_baseline(volumes)

    float volumePercentile = f_percent_rank(volumes, volume)

    [relativeRange, localRvol, neutralResponse, bodyEfficiency, directionalResponse] = f_response(rangePx, volume, rangeBase, volumeBase, open, close)

    if barstate.isconfirmed

        f_push_capped(ranges, rangePx, populationCap)

        f_push_capped(volumes, volume, populationCap)

    [popSize, relativeRange, localRvol, neutralResponse, bodyEfficiency, directionalResponse, volumePercentile]

// ── Native chart-timeframe values for Daily and higher.

[rPopSize, rRelativeRange, rRvol, rNeutralResponse, rBodyEfficiency, rDirectionalResponse, rVolumePercentile] = f_rollup_engine(effectiveLookback)

// ── Select active regime.

int activePopSize = 0

float relativeRange = na

float rvol = na

float neutralResponse = na

float bodyEfficiency = na

float directionalResponse = na

float volumePercentile = na

if chartIsIntraday

    activePopSize := iPopSize

    relativeRange := iRelativeRange

    rvol := iRvol

    neutralResponse := iNeutralResponse

    bodyEfficiency := iBodyEfficiency

    directionalResponse := iDirectionalResponse

    volumePercentile := iVolumePercentile

else

    activePopSize := rPopSize

    relativeRange := rRelativeRange

    rvol := rRvol

    neutralResponse := rNeutralResponse

    bodyEfficiency := rBodyEfficiency

    directionalResponse := rDirectionalResponse

    volumePercentile := rVolumePercentile

bool ready = activePopSize >= effectiveLookback

bool confirmedObservation = barstate.isconfirmed

// ── Confirmed signal states.

// These are shared by chart markers, alerts and Pine Screener flags.

bool resistantResponse = ready and confirmedObservation and not na(neutralResponse) and neutralResponse <= lowResponseThreshold

bool efficientRally = ready and confirmedObservation and not na(directionalResponse) and directionalResponse >= highDirectionalThreshold

bool efficientDrop = ready and confirmedObservation and not na(directionalResponse) and directionalResponse <= -highDirectionalThreshold

bool momentumEitherSide = efficientRally or efficientDrop

// Signed Body Efficiency zero-cross alerts are intentionally independent of Price Response.

// Evaluate cross functions on every calculation, then gate the alert state to confirmed bars.

bool bodyEfficiencyCrossUpRaw = ta.crossover(bodyEfficiency, 0.0)

bool bodyEfficiencyCrossDownRaw = ta.crossunder(bodyEfficiency, 0.0)

bool bodyEfficiencyCrossUp = confirmedObservation and bodyEfficiencyCrossUpRaw

bool bodyEfficiencyCrossDown = confirmedObservation and bodyEfficiencyCrossDownRaw

// ── Pine Screener / numerical outputs.

// Keep these as the first ten plot() calls. They are hidden from the pane but available in

// the Data Window, numeric alerts and Pine Screener columns/filters. Signal flags are 1/0.

plot(directionalResponse, title="Price Response Numerical", display=display.data_window)

plot(bodyEfficiency, title="Signed Body Efficiency Numerical", display=display.data_window)

plot(neutralResponse, title="Neutral Price Response Data", display=display.data_window)

plot(rvol, title="RVOL Data", display=display.data_window)

plot(relativeRange, title="Relative Range Data", display=display.data_window)

plot(volumePercentile, title="Volume Percentile Data", display=display.data_window)

plot(ready ? 1.0 : 0.0, title="Screener Ready Flag", display=display.data_window)

plot(efficientRally ? 1.0 : 0.0, title="Green Dot - Efficient Rally Flag", display=display.data_window)

plot(efficientDrop ? 1.0 : 0.0, title="Red Dot - Efficient Drop Flag", display=display.data_window)

plot(resistantResponse ? 1.0 : 0.0, title="Orange Dot - Resistant Response Flag", display=display.data_window)

// Display the current realtime bar as it develops; signals/alerts remain confirmed-only.

bool displayObservation = confirmedObservation or barstate.isrealtime

float directionalPlot = na

float neutralPlot = na

float rangePlot = na

float rvolPlot = na

float bodyPlot = na

if ready and displayObservation

    if showDirectionalResponse

        directionalPlot := directionalResponse

    if showNeutralResponse

        neutralPlot := neutralResponse

    if showRelativeRange

        rangePlot := relativeRange

    if showRvol

        rvolPlot := rvol

    if showBodyEfficiency

        bodyPlot := bodyEfficiency

color directionalColor = rallyColor

if not na(directionalResponse) and directionalResponse < 0

    directionalColor := dropColor

plot(directionalPlot, title="Directional Price Response", color=directionalColor, linewidth=2, style=plot.style_histogram)

plot(neutralPlot, title="Neutral Price Response", color=neutralColor, linewidth=1)

plot(rangePlot, title="Relative Range", color=rangeColor, linewidth=1)

plot(rvolPlot, title="RVOL", color=rvolColor, linewidth=1)

plot(bodyPlot, title="Signed Body Efficiency", color=bodyColor, linewidth=1)

plot(0.0, title="Directional Center", color=color.new(color.gray, 45), linewidth=1)

// ── Optional neutral-response guides.

float neutralBalanced = na

float lowResponseLine = na

float positiveDirectionalLine = na

float negativeDirectionalLine = na

if showThresholds

    if showNeutralResponse

        neutralBalanced := 1.0

        lowResponseLine := lowResponseThreshold

    positiveDirectionalLine := highDirectionalThreshold

    negativeDirectionalLine := -highDirectionalThreshold

plot(neutralBalanced, title="Neutral Balanced Response", color=color.new(color.gray, 65), linewidth=1)

plot(lowResponseLine, title="Low Neutral Response Threshold", color=color.new(color.orange, 35), linewidth=1)

plot(positiveDirectionalLine, title="Strong Rally Response Threshold", color=color.new(color.green, 35), linewidth=1)

plot(negativeDirectionalLine, title="Strong Drop Response Threshold", color=color.new(color.red, 35), linewidth=1)

// ── Lower-pane markers.

// Green = efficient rally; Red = efficient drop; Orange = resistant/base-like response.

// location.top / location.bottom makes marker placement independent of the numeric Y-scale.

plotshape(resistantResponse, title="Orange Dot - Resistant Response", style=shape.circle, location=location.bottom, color=color.orange, size=size.tiny)

plotshape(efficientRally, title="Green Dot - Efficient Rally", style=shape.circle, location=location.top, color=rallyColor, size=size.tiny)

plotshape(efficientDrop, title="Red Dot - Efficient Drop", style=shape.circle, location=location.bottom, color=dropColor, size=size.tiny)

// ── Alerts.

// Conditions are unchanged. Only titles/messages are clarified to match the chart dots and logic.

// Raw numerical plots remain separate for user-selected operators and thresholds.

alertcondition(efficientRally, title="Efficient Rally (Green Dot)", message="Efficient Rally (Green Dot) | {{ticker}} | {{interval}} | Price Response={{plot(\"Price Response Numerical\")}}")

alertcondition(efficientDrop, title="Efficient Drop (Red Dot)", message="Efficient Drop (Red Dot) | {{ticker}} | {{interval}} | Price Response={{plot(\"Price Response Numerical\")}}")

alertcondition(momentumEitherSide, title="Efficient Rally or Drop (Green/Red Dot)", message="Efficient Rally or Drop (Green/Red Dot) | {{ticker}} | {{interval}} | Price Response={{plot(\"Price Response Numerical\")}}")

alertcondition(resistantResponse, title="Resistant Response (Orange Dot)", message="Resistant Response (Orange Dot) | {{ticker}} | {{interval}} | Neutral Response={{plot(\"Neutral Price Response Data\")}} | Price Response={{plot(\"Price Response Numerical\")}}")

alertcondition(bodyEfficiencyCrossUp, title="Signed Body Efficiency Cross Above 0", message="Signed Body Efficiency Cross Above 0 | {{ticker}} | {{interval}} | Signed Body Efficiency={{plot(\"Signed Body Efficiency Numerical\")}} | Price Response={{plot(\"Price Response Numerical\")}}")

alertcondition(bodyEfficiencyCrossDown, title="Signed Body Efficiency Cross Below 0", message="Signed Body Efficiency Cross Below 0 | {{ticker}} | {{interval}} | Signed Body Efficiency={{plot(\"Signed Body Efficiency Numerical\")}} | Price Response={{plot(\"Price Response Numerical\")}}")

// ── Data Window.

// Mode Code 1 = intraday native same-start-slot history. Mode Code 2 = Daily-or-higher native history.

float modeCode = 2.0

if chartIsIntraday

    modeCode := 1.0

plot(modeCode, title="Analysis Mode Code", display=display.data_window)

plot(activePopSize, title="Population Size", display=display.data_window)

plot(effectiveLookback, title="Effective Lookback Periods", display=display.data_window)
