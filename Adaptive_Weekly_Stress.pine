//@version=6

indicator("Adaptive Weekly Stress", shorttitle="AWS", overlay=false)

// Revision: 1.04
// Symbol-agnostic stress engine for chart display, Pine Screener columns,
// and watchlist alerts.
//
// TIMEFRAME BEHAVIOR
// - Intraday charts below 130 minutes use a 130-minute analysis floor.
// - 130m and 195m charts use their native chart timeframe.
// - Other intraday charts above 130m use their native timeframe; the intended
//   quality-validated intraday workflow is 130m or 195m.
// - Daily and higher charts use their native chart timeframe.
// - Intraday lookbacks are converted to trading-day-equivalent sample counts.
// - Intraday percentile history uses a shorter 63-trading-day default so the
//   engine remains sensitive to the current volatility regime.
// - Day-equivalent intraday scaling assumes a 390-minute regular session.
// - Developing mode can change before the active analysis bar closes.
// - Confirmed mode uses only the last completed analysis bar.
//
// STYLE HYGIENE
// - Internal Screener/Data Window plots remain available to Pine Screener and
//   alerts but are non-editable so they do not create meaningless Style controls.
// - User-visible pane plots and reference levels retain meaningful Style controls.

// ============================================================================
// INPUTS
// ============================================================================

groupCalc = "Calculation"

dataMode = input.string(
     "Developing",
     "Data Mode",
     options=["Developing", "Confirmed"],
     group=groupCalc,
     tooltip="Developing uses the active analysis bar and can change before that bar closes. Confirmed uses only the last completed analysis bar for stable, non-repainting values."
 )

useConfirmedBar = dataMode == "Confirmed"

wvfLookback = input.int(
     22,
     "WVF Highest-Close Lookback",
     minval=2,
     group=groupCalc,
     tooltip="Daily and higher: number of chart bars used for the Williams VIX Fix highest-close reference. Intraday: interpreted as trading days and converted to analysis bars. With the 130m floor, 22 means about 66 analysis bars."
 )

atrLength = input.int(
     14,
     "ATR Length (analysis bars)",
     minval=1,
     group=groupCalc,
     tooltip="ATR smoothing length in analysis bars on every timeframe. Intraday ATR is deliberately not converted to trading days: keeping the default at 14 analysis bars lets the local volatility estimate respond while the slower 26-day median baseline provides normalization stability."
 )

atrBaselineLength = input.int(
     26,
     "ATR% Baseline Median",
     minval=2,
     group=groupCalc,
     tooltip="Daily and higher: median lookback in chart bars. Intraday: interpreted as trading days and converted to analysis bars. Median reduces distortion from isolated volatility spikes."
 )

percentileLookback = input.int(
     156,
     "Percentile Lookback (D+ bars)",
     minval=20,
     maxval=400,
     group=groupCalc,
     tooltip="Historical population used to rank normalized stress and stress velocity on Daily and higher chart timeframes. On a weekly chart, 156 bars is about three years."
 )

intradayPercentileDays = input.int(
     63,
     "Intraday Percentile History (trading days)",
     minval=26,
     maxval=126,
     group=groupCalc,
     tooltip="Intraday-only percentile history. 63 trading days is about one quarter: long enough for a stable percentile population while short enough to adapt when the volatility regime changes. At 130m this is about 189 analysis bars; at 195m about 126."
 )

groupSignals = "Signal Thresholds"

longExtremeThreshold = input.float(
     95.0,
     "Long Extreme Stress %ile",
     minval=50.0,
     maxval=100.0,
     step=0.5,
     group=groupSignals,
     tooltip="Long-watch threshold. A value of 95 means normalized downside stress is at or above roughly the 95th percentile of this symbol's own historical stress distribution on the active analysis timeframe."
 )

expansionThreshold = input.float(
     95.0,
     "Short Expansion Velocity %ile",
     minval=50.0,
     maxval=100.0,
     step=0.5,
     group=groupSignals,
     tooltip="Short-watch threshold. A value of 95 means the current analysis-bar increase in normalized stress ranks near the most rapid historical stress expansions for this symbol."
 )

shortStressFloor = input.float(
     50.0,
     "Short Expansion Minimum Stress %ile",
     minval=0.0,
     maxval=99.0,
     step=0.5,
     group=groupSignals,
     tooltip="Minimum stress percentile required before the rapid-expansion state can qualify as a Short Expansion signal. The default 50 requires stress to be above its own historical median before a velocity spike can signal."
 )

groupQuantAlerts = "Quantitative Stress Alerts"

stressLevelThreshold = input.float(
     80.0,
     "Stress %ile Level Threshold",
     minval=0.0,
     maxval=100.0,
     step=0.5,
     group=groupQuantAlerts,
     tooltip="Numeric Stress %ile threshold used by the Stress %ile Level alert. The separate Level Condition setting controls whether the alert watches for an upward or downward threshold event."
 )

stressLevelCondition = input.string(
     "Cross Above",
     "Stress %ile Level Condition",
     options=["Cross Above", "Cross Below", "At/Above", "At/Below"],
     group=groupQuantAlerts,
     tooltip="Cross Above/Below requires a threshold crossing. At/Above or At/Below fires when that state first becomes true, rather than repeating on every bar while the state remains true."
 )

stressChangeBars = input.int(
     2,
     "Stress %ile Change Bars",
     minval=1,
     maxval=20,
     group=groupQuantAlerts,
     tooltip="Number of analysis bars used for Stress %ile Change. Change = current Stress %ile minus Stress %ile this many analysis bars ago. On 26m/39m/79m charts these are 130m analysis bars because of the quality floor."
 )

stressRisePoints = input.float(
     15.0,
     "Stress %ile Rise (points)",
     minval=0.5,
     maxval=100.0,
     step=0.5,
     group=groupQuantAlerts,
     tooltip="Stress %ile Rise alert threshold in percentile points over the configured Change Bars. Example: 55 to 72 is a +17 point rise."
 )

stressDropPoints = input.float(
     15.0,
     "Stress %ile Drop (points)",
     minval=0.5,
     maxval=100.0,
     step=0.5,
     group=groupQuantAlerts,
     tooltip="Stress %ile Drop alert threshold in percentile points over the configured Change Bars. Example: 92 to 70 is a 22 point drop."
 )

useStressMoveLevelQualifier = input.bool(
     false,
     "Qualify Rise/Drop by Absolute Stress",
     group=groupQuantAlerts,
     tooltip="When enabled, Rise requires the current Stress %ile to be at or above the qualifier. Drop requires Stress %ile at the START of the measured move to be at or above the qualifier. This avoids treating a large move from an unimportant stress level the same as a move involving elevated stress."
 )

stressMoveLevelQualifier = input.float(
     75.0,
     "Rise/Drop Stress %ile Qualifier",
     minval=0.0,
     maxval=100.0,
     step=0.5,
     group=groupQuantAlerts,
     tooltip="Absolute Stress %ile used only when Qualify Rise/Drop by Absolute Stress is enabled. Rise qualifies on the current Stress %ile; Drop qualifies on the Stress %ile from Change Bars ago."
 )

groupDisplay = "Display"

showVelocity = input.bool(
     true,
     "Show Velocity %ile",
     group=groupDisplay,
     tooltip="Shows the adaptive percentile rank of stress velocity in the indicator pane."
 )

showSignalMarkers = input.bool(
     true,
     "Show Signal Markers",
     group=groupDisplay,
     tooltip="Shows markers when Short Expansion begins, Long Extreme is first breached, and Long Turn begins."
 )

showDashboard = input.bool(
     true,
     "Show Current-State Table",
     group=groupDisplay,
     tooltip="Shows a compact table for the current symbol. The Pine Screener does not read table cells; screener values come from the first ten plots below."
 )

showStateBackground = input.bool(
     true,
     "Shade Active State",
     group=groupDisplay,
     tooltip="Lightly shades the pane for active Short Expansion, Long Extreme, or Long Turn states."
 )

stressColor = input.color(color.aqua, "Stress %ile Color", group=groupDisplay)
velocityColor = input.color(color.orange, "Velocity %ile Color", group=groupDisplay)
longColor = input.color(color.lime, "Long-State Color", group=groupDisplay)
shortColor = input.color(color.red, "Short-State Color", group=groupDisplay)
neutralColor = input.color(color.gray, "Neutral Color", group=groupDisplay)

// ============================================================================
// ADAPTIVE TIMEFRAME AND LOOKBACK ENGINE
// ============================================================================

// 130m is the quality floor for intraday analysis.
// 26m / 39m / 79m charts therefore read the same 130m stress engine.
// 130m charts use native 130m calculations.
// 195m charts use native 195m calculations.
int intradayFloorSeconds = 130 * 60
float chartSeconds = timeframe.in_seconds()
bool useIntradayFloor = timeframe.isintraday and chartSeconds < intradayFloorSeconds

string analysisTimeframe = timeframe.period
if useIntradayFloor
    analysisTimeframe := "130"

// Convert the user's day-based intraday settings into a comparable number of
// analysis bars. The intended U.S. equity workflow uses a 390-minute regular
// session: 130m = 3 bars/day and 195m = 2 bars/day.
int intradayBarsPerDay = 1
if timeframe.isintraday
    float analysisMinutes = timeframe.in_seconds(analysisTimeframe) / 60.0
    intradayBarsPerDay := math.max(1, int(math.round(390.0 / analysisMinutes)))

int effectiveWvfLookback = wvfLookback
int effectiveAtrLength = atrLength
int effectiveAtrBaselineLength = atrBaselineLength
int effectivePercentileLookback = percentileLookback

if timeframe.isintraday
    effectiveWvfLookback := math.max(2, wvfLookback * intradayBarsPerDay)
    effectiveAtrLength := atrLength
    effectiveAtrBaselineLength := math.max(2, atrBaselineLength * intradayBarsPerDay)
    effectivePercentileLookback := math.max(20, intradayPercentileDays * intradayBarsPerDay)

// ============================================================================
// STRESS CALCULATION ENGINE
// ============================================================================

f_stressMetrics(bool previousBar) =>
    float highestClose = ta.highest(close, effectiveWvfLookback)
    float wvf = not na(highestClose) and highestClose != 0.0 ? ((highestClose - low) / highestClose) * 100.0 : na

    float atrValue = ta.atr(effectiveAtrLength)
    float atrPercent = not na(close) and close != 0.0 ? (atrValue / close) * 100.0 : na
    float baselineAtrPercent = ta.median(atrPercent, effectiveAtrBaselineLength)

    float normalizedStress = not na(baselineAtrPercent) and baselineAtrPercent > 0.0 ? wvf / baselineAtrPercent : na
    float stressPercentile = ta.percentrank(normalizedStress, effectivePercentileLookback)

    float stressVelocity = normalizedStress - normalizedStress[1]
    float velocityPercentile = ta.percentrank(stressVelocity, effectivePercentileLookback)

    float stressPercentileChange = stressPercentile - stressPercentile[stressChangeBars]

    bool stressLevelAtOrAbove = not na(stressPercentile) and stressPercentile >= stressLevelThreshold
    bool stressLevelAtOrBelow = not na(stressPercentile) and stressPercentile <= stressLevelThreshold
    bool stressLevelCrossAbove = ta.crossover(stressPercentile, stressLevelThreshold)
    bool stressLevelCrossBelow = ta.crossunder(stressPercentile, stressLevelThreshold)
    bool stressLevelEvent = false
    if stressLevelCondition == "Cross Above"
        stressLevelEvent := stressLevelCrossAbove
    else if stressLevelCondition == "Cross Below"
        stressLevelEvent := stressLevelCrossBelow
    else if stressLevelCondition == "At/Above"
        stressLevelEvent := stressLevelAtOrAbove and not stressLevelAtOrAbove[1]
    else
        stressLevelEvent := stressLevelAtOrBelow and not stressLevelAtOrBelow[1]

    bool stressRiseQualified = not useStressMoveLevelQualifier or stressPercentile >= stressMoveLevelQualifier
    bool stressDropQualified = not useStressMoveLevelQualifier or stressPercentile[stressChangeBars] >= stressMoveLevelQualifier
    bool stressRiseState = not na(stressPercentileChange) and stressPercentileChange >= stressRisePoints and stressRiseQualified
    bool stressDropState = not na(stressPercentileChange) and stressPercentileChange <= -stressDropPoints and stressDropQualified
    bool stressRiseEvent = stressRiseState and not stressRiseState[1]
    bool stressDropEvent = stressDropState and not stressDropState[1]

    bool longExtremeState = not na(stressPercentile) and stressPercentile >= longExtremeThreshold
    bool longTurnState = longExtremeState and not na(stressVelocity) and stressVelocity < 0.0
    bool shortExpansionState = not na(velocityPercentile) and stressPercentile >= shortStressFloor and stressPercentile < longExtremeThreshold and stressVelocity > 0.0 and velocityPercentile >= expansionThreshold

    bool longExtremeEvent = ta.crossover(stressPercentile, longExtremeThreshold)
    bool longTurnEvent = longTurnState and not longTurnState[1]
    bool shortExpansionEvent = shortExpansionState and not shortExpansionState[1]

    int barsSinceExtreme = ta.barssince(longExtremeEvent)

    float outStressPercentile = previousBar ? stressPercentile[1] : stressPercentile
    float outNormalizedStress = previousBar ? normalizedStress[1] : normalizedStress
    float outVelocityPercentile = previousBar ? velocityPercentile[1] : velocityPercentile
    float outStressVelocity = previousBar ? stressVelocity[1] : stressVelocity
    float outWvf = previousBar ? wvf[1] : wvf
    float outBaselineAtrPercent = previousBar ? baselineAtrPercent[1] : baselineAtrPercent
    float outStressPercentileChange = previousBar ? stressPercentileChange[1] : stressPercentileChange

    bool outLongExtremeState = previousBar ? longExtremeState[1] : longExtremeState
    bool outLongTurnState = previousBar ? longTurnState[1] : longTurnState
    bool outShortExpansionState = previousBar ? shortExpansionState[1] : shortExpansionState
    int outBarsSinceExtreme = previousBar ? barsSinceExtreme[1] : barsSinceExtreme

    bool outLongExtremeEvent = previousBar ? longExtremeEvent[1] : longExtremeEvent
    bool outLongTurnEvent = previousBar ? longTurnEvent[1] : longTurnEvent
    bool outShortExpansionEvent = previousBar ? shortExpansionEvent[1] : shortExpansionEvent
    bool outStressLevelEvent = previousBar ? stressLevelEvent[1] : stressLevelEvent
    bool outStressRiseEvent = previousBar ? stressRiseEvent[1] : stressRiseEvent
    bool outStressDropEvent = previousBar ? stressDropEvent[1] : stressDropEvent

    [outStressPercentile, outNormalizedStress, outVelocityPercentile, outStressVelocity, outWvf, outBaselineAtrPercent, outStressPercentileChange, outLongExtremeState, outLongTurnState, outShortExpansionState, outBarsSinceExtreme, outLongExtremeEvent, outLongTurnEvent, outShortExpansionEvent, outStressLevelEvent, outStressRiseEvent, outStressDropEvent]

[devStressPercentile, devNormalizedStress, devVelocityPercentile, devStressVelocity, devWvf, devBaselineAtrPercent, devStressPercentileChange, devLongExtremeState, devLongTurnState, devShortExpansionState, devBarsSinceExtreme, devLongExtremeEvent, devLongTurnEvent, devShortExpansionEvent, devStressLevelEvent, devStressRiseEvent, devStressDropEvent] = request.security(
     syminfo.tickerid,
     analysisTimeframe,
     f_stressMetrics(false),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off
 )

[confStressPercentile, confNormalizedStress, confVelocityPercentile, confStressVelocity, confWvf, confBaselineAtrPercent, confStressPercentileChange, confLongExtremeState, confLongTurnState, confShortExpansionState, confBarsSinceExtreme, confLongExtremeEventRaw, confLongTurnEventRaw, confShortExpansionEventRaw, confStressLevelEventRaw, confStressRiseEventRaw, confStressDropEventRaw] = request.security(
     syminfo.tickerid,
     analysisTimeframe,
     f_stressMetrics(true),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_on
 )

float stressPercentile = useConfirmedBar ? confStressPercentile : devStressPercentile
float normalizedStress = useConfirmedBar ? confNormalizedStress : devNormalizedStress
float velocityPercentile = useConfirmedBar ? confVelocityPercentile : devVelocityPercentile
float stressVelocity = useConfirmedBar ? confStressVelocity : devStressVelocity
float wvf = useConfirmedBar ? confWvf : devWvf
float baselineAtrPercent = useConfirmedBar ? confBaselineAtrPercent : devBaselineAtrPercent
float stressPercentileChange = useConfirmedBar ? confStressPercentileChange : devStressPercentileChange

bool longExtremeState = useConfirmedBar ? confLongExtremeState : devLongExtremeState
bool longTurnState = useConfirmedBar ? confLongTurnState : devLongTurnState
bool shortExpansionState = useConfirmedBar ? confShortExpansionState : devShortExpansionState
int barsSinceExtreme = useConfirmedBar ? confBarsSinceExtreme : devBarsSinceExtreme

bool newAnalysisPeriod = timeframe.change(analysisTimeframe)

bool longExtremeEvent = devLongExtremeEvent
bool longTurnEvent = devLongTurnEvent
bool shortExpansionEvent = devShortExpansionEvent
bool stressLevelEvent = devStressLevelEvent
bool stressRiseEvent = devStressRiseEvent
bool stressDropEvent = devStressDropEvent

if useConfirmedBar
    longExtremeEvent := confLongExtremeEventRaw and newAnalysisPeriod
    longTurnEvent := confLongTurnEventRaw and newAnalysisPeriod
    shortExpansionEvent := confShortExpansionEventRaw and newAnalysisPeriod
    stressLevelEvent := confStressLevelEventRaw and newAnalysisPeriod
    stressRiseEvent := confStressRiseEventRaw and newAnalysisPeriod
    stressDropEvent := confStressDropEventRaw and newAnalysisPeriod

// ============================================================================
// FIRST 10 PLOTS = PINE SCREENER COLUMNS
// Keep these first and in this order. Internal/output-only plots are non-editable
// so they remain available to Screener/Data Window without cluttering Style.
// ============================================================================

plot(
     stressPercentile,
     "Stress %ile",
     color=stressColor,
     linewidth=2,
     display=display.pane + display.data_window + display.pine_screener
 )

plot(
     normalizedStress,
     "Normalized Stress",
     color=stressColor,
     display=display.data_window + display.pine_screener,
     editable=false
 )

plot(
     velocityPercentile,
     "Velocity %ile",
     color=velocityColor,
     display=display.data_window + display.pine_screener,
     editable=false
 )

plot(
     stressVelocity,
     "Stress Velocity",
     color=velocityColor,
     display=display.data_window + display.pine_screener,
     editable=false
 )

plot(
     wvf,
     "WVF",
     color=neutralColor,
     display=display.data_window + display.pine_screener,
     editable=false
 )

plot(
     baselineAtrPercent,
     "Baseline ATR %",
     color=neutralColor,
     display=display.data_window + display.pine_screener,
     editable=false
 )

plot(
     longExtremeState ? 1.0 : 0.0,
     "Long Extreme",
     color=longColor,
     display=display.data_window + display.pine_screener,
     editable=false
 )

plot(
     longTurnState ? 1.0 : 0.0,
     "Long Turn",
     color=longColor,
     display=display.data_window + display.pine_screener,
     editable=false
 )

plot(
     shortExpansionState ? 1.0 : 0.0,
     "Short Expansion",
     color=shortColor,
     display=display.data_window + display.pine_screener,
     editable=false
 )

plot(
     barsSinceExtreme,
     "Bars Since Extreme",
     color=neutralColor,
     display=display.data_window + display.pine_screener,
     editable=false
 )

// Quantitative alert/output helper. This is intentionally after the first ten
// plots so it does not displace an existing Pine Screener column.
plot(
     stressPercentileChange,
     "Stress %ile Change",
     color=neutralColor,
     display=display.data_window,
     editable=false
 )

// ============================================================================
// CHART REFERENCE LEVELS AND SIGNAL DISPLAY
// ============================================================================

// Visible velocity line is deliberately separate from the first ten Screener
// plots so Show Velocity cannot blank the Pine Screener column.
plot(
     showVelocity ? velocityPercentile : na,
     "Velocity %ile - Chart",
     color=velocityColor,
     linewidth=1,
     display=display.pane
 )

hline(shortStressFloor, "Short Stress Floor", color=color.new(neutralColor, 55), linestyle=hline.style_dashed)
hline(longExtremeThreshold, "Long Extreme Threshold", color=color.new(longColor, 25), linestyle=hline.style_dotted)
hline(expansionThreshold, "Velocity Expansion Threshold", color=color.new(shortColor, 40), linestyle=hline.style_dotted)

plotshape(
     showSignalMarkers and shortExpansionEvent,
     title="Short Expansion Marker",
     style=shape.triangledown,
     location=location.top,
     color=shortColor,
     size=size.tiny,
     text="S"
 )

plotshape(
     showSignalMarkers and longExtremeEvent,
     title="Long Extreme Marker",
     style=shape.circle,
     location=location.bottom,
     color=longColor,
     size=size.tiny,
     text="X"
 )

plotshape(
     showSignalMarkers and longTurnEvent,
     title="Long Turn Marker",
     style=shape.triangleup,
     location=location.bottom,
     color=longColor,
     size=size.small,
     text="L"
 )

color stateBackground = na
if showStateBackground
    if longTurnState
        stateBackground := color.new(longColor, 88)
    else if longExtremeState
        stateBackground := color.new(longColor, 93)
    else if shortExpansionState
        stateBackground := color.new(shortColor, 91)

bgcolor(stateBackground, title="Adaptive Stress State", editable=false)

// ============================================================================
// CURRENT-SYMBOL DASHBOARD
// ============================================================================

string stateText = "NEUTRAL"
color stateColor = neutralColor

if longTurnState
    stateText := "LONG TURN"
    stateColor := longColor
else if longExtremeState
    stateText := "LONG EXTREME"
    stateColor := longColor
else if shortExpansionState
    stateText := "SHORT EXPANSION"
    stateColor := shortColor

string analysisLabel = analysisTimeframe
if analysisTimeframe == "130"
    analysisLabel := "130m"
else if analysisTimeframe == "195"
    analysisLabel := "195m"

string modeLabel = " DEV"
if useConfirmedBar
    modeLabel := " CONF"

if useIntradayFloor
    analysisLabel := analysisLabel + " FLOOR"

var table dashboard = table.new(position.top_right, 2, 10, border_width=1)

if barstate.islast
    if showDashboard
        table.cell(dashboard, 0, 0, "Adaptive Stress", text_color=color.white, bgcolor=color.new(neutralColor, 55))
        table.cell(dashboard, 1, 0, analysisLabel + modeLabel, text_color=color.white, bgcolor=color.new(neutralColor, 55))

        table.cell(dashboard, 0, 1, "Stress %ile")
        table.cell(dashboard, 1, 1, str.tostring(stressPercentile, "#.##"))

        table.cell(dashboard, 0, 2, "Normalized Stress")
        table.cell(dashboard, 1, 2, str.tostring(normalizedStress, "#.###"))

        table.cell(dashboard, 0, 3, "Velocity %ile")
        table.cell(dashboard, 1, 3, str.tostring(velocityPercentile, "#.##"))

        table.cell(dashboard, 0, 4, "Stress %ile Change (" + str.tostring(stressChangeBars) + ")")
        table.cell(dashboard, 1, 4, str.tostring(stressPercentileChange, "#.##"))

        table.cell(dashboard, 0, 5, "Stress Velocity")
        table.cell(dashboard, 1, 5, str.tostring(stressVelocity, "#.###"))

        table.cell(dashboard, 0, 6, "WVF")
        table.cell(dashboard, 1, 6, str.tostring(wvf, "#.##"))

        table.cell(dashboard, 0, 7, "Baseline ATR %")
        table.cell(dashboard, 1, 7, str.tostring(baselineAtrPercent, "#.##"))

        table.cell(dashboard, 0, 8, "Bars Since Extreme")
        table.cell(dashboard, 1, 8, str.tostring(barsSinceExtreme))

        table.cell(dashboard, 0, 9, "State")
        table.cell(dashboard, 1, 9, stateText, text_color=stateColor)
    else
        table.clear(dashboard, 0, 0, 1, 9)

// ============================================================================
// ALERTS
// Existing alert names are unchanged. Three quantitative alerts are added.
// ============================================================================

alertcondition(
     shortExpansionEvent,
     title="Adaptive Stress Expansion",
     message="Adaptive Stress Expansion on {{ticker}}: analysis-timeframe normalized stress has begun expanding at a historically unusual rate. Stress %ile={{plot(\"Stress %ile\")}}, Velocity %ile={{plot(\"Velocity %ile\")}}."
 )

alertcondition(
     longExtremeEvent,
     title="Adaptive Stress Extreme",
     message="Adaptive Stress Extreme on {{ticker}}: analysis-timeframe normalized stress has crossed the configured extreme percentile threshold. Stress %ile={{plot(\"Stress %ile\")}}, Normalized Stress={{plot(\"Normalized Stress\")}}."
 )

alertcondition(
     longTurnEvent,
     title="Adaptive Stress Turn",
     message="Adaptive Stress Turn on {{ticker}}: stress remains extreme and its analysis-bar velocity has turned negative. Stress %ile={{plot(\"Stress %ile\")}}, Stress Velocity={{plot(\"Stress Velocity\")}}."
 )

alertcondition(
     stressLevelEvent,
     title="Stress %ile Level",
     message="Stress %ile Level on {{ticker}}: the configured numeric Stress %ile level condition has triggered. Stress %ile={{plot(\"Stress %ile\")}}, Stress %ile Change={{plot(\"Stress %ile Change\")}}."
 )

alertcondition(
     stressRiseEvent,
     title="Stress %ile Rise",
     message="Stress %ile Rise on {{ticker}}: Stress %ile has risen by at least the configured number of percentile points over the configured analysis-bar window. Stress %ile={{plot(\"Stress %ile\")}}, Stress %ile Change={{plot(\"Stress %ile Change\")}}."
 )

alertcondition(
     stressDropEvent,
     title="Stress %ile Drop",
     message="Stress %ile Drop on {{ticker}}: Stress %ile has dropped by at least the configured number of percentile points over the configured analysis-bar window. Stress %ile={{plot(\"Stress %ile\")}}, Stress %ile Change={{plot(\"Stress %ile Change\")}}."
 )
