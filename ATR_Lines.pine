//@version=6

// Revision: 1.03
// Changelog:
// 1.03 - Reworked the defensive range calculation for covered-call strike context.
//        H/D/W now use only their own completed True Range bars: H=70, D=21, W=13
//        by default. Range statistic choices are Avg, 90th percentile, and Max.
//        Removed all sub-timeframe ATR blending; probability bands remain independent.
// 1.02 - Restored Week/Day/Hour scope and completed-period selectors for ATR/range
//        calculations. ATR remains anchored to live close. Probability bands are
//        independent of ATR logic and are off by default.
// 1.01 - Added source-level documentation and tooltips for the fixed current-day
//        scope, live-price anchoring, ATR blend, and probability-band models.
//        No calculation, alert, or timeframe behavior was changed.

indicator("ATR Lines", shorttitle="ATR Lines", overlay=true, max_lines_count=20, max_labels_count=20)

//====================================================================

// HELPERS

//====================================================================

get_label_text(show_d, d_text, show_p, p_val) =>

    string out = ""

    if show_d

        out := d_text

    if show_p

        out := out + (show_d ? " : " : "") + str.tostring(p_val, format.mintick)

    out

get_selected_value(sel, o, h, l, c) =>

    switch sel

        "Open"  => o

        "High"  => h

        "Low"   => l

        "Close" => c

        => o

// Computes defensive range statistics from COMPLETED bars only on the requested
// scope. Shifting True Range by one bar prevents a partial current H/D/W bar from
// biasing the population lower early in the period. The 90th percentile uses
// linear interpolation so it is conservative without collapsing to a single max.
get_confirmed_tr_stats(_lookback) =>

    float raw_tr = ta.tr(true)

    float confirmed_tr = raw_tr[1]

    float avg_tr = ta.sma(confirmed_tr, _lookback)

    float p90_tr = ta.percentile_linear_interpolation(confirmed_tr, _lookback, 90.0)

    float max_tr = ta.highest(confirmed_tr, _lookback)

    [avg_tr, p90_tr, max_tr]

//====================================================================

// USER SETTINGS

//====================================================================

// The selected scope controls the True Range population and reference OHLC lines.
// H uses 60-minute bars only, D uses Daily bars only, and W uses Weekly bars only.
// No lower/sub-timeframe data is mixed into the range statistic. Range and
// probability bands are always centered on live/current close.
g_mode = "Timeframe Mode"

tf_mode = input.string(
     "Week",
     title="Active Timeframe Scope",
     options=["Week", "Day", "Hour"],
     group=g_mode,
     tooltip="Controls the range population and reference OHLC scope. Hour uses 60-minute bars only, Day uses Daily bars only, and Week uses Weekly bars only. No sub-timeframe data is mixed in. The range center remains live Current Price.")

// Separate selectors preserve the historical reference period for Line 1 and
// Line 2 only. They do NOT affect the Avg/P90/Max range population or its anchor.
week_select = input.string(
     "LW",
     title="Week Selection",
     options=["CW", "LW", "-2WK", "-3W"],
     group=g_mode,
     tooltip="Reference period for Line 1 and Line 2 only. CW = current week; LW = previous completed week; -2WK/-3W = earlier completed weeks. Range statistics always use the configured Weekly lookback and live Current Price anchor.")

day_select = input.string(
     "YD",
     title="Day Selection",
     options=["Curr D", "YD", "-2D", "-3D"],
     group=g_mode,
     tooltip="Reference period for Line 1 and Line 2 only. Curr D = current trading day; YD = previous completed trading day; -2D/-3D = earlier completed days. Range statistics always use the configured Daily lookback and live Current Price anchor.")

hour_select = input.string(
     "YH",
     title="Hour Selection",
     options=["Curr H", "YH", "-2H", "-3H"],
     group=g_mode,
     tooltip="Reference period for Line 1 and Line 2 only. Curr H = current 60-minute period; YH = previous completed 60-minute period; -2H/-3H = earlier completed hours. Range statistics always use the configured Hourly lookback and live Current Price anchor.")

string active_select = switch tf_mode
    "Week" => week_select
    "Day"  => day_select
    "Hour" => hour_select
    => week_select

int period_offset = switch active_select
    "CW"     => 0
    "LW"     => 1
    "-2WK"   => 2
    "-3W"    => 3
    "Curr D" => 0
    "YD"     => 1
    "-2D"    => 2
    "-3D"    => 3
    "Curr H" => 0
    "YH"     => 1
    "-2H"    => 2
    "-3H"    => 3
    => 0

string target_tf = switch tf_mode
    "Week" => "1W"
    "Day"  => "1D"
    "Hour" => "60"
    => "1W"

string tf_code = switch tf_mode
    "Week" => "W"
    "Day"  => "D"
    "Hour" => "H"
    => "W"

// Current-period OHLC is reconstructed from chart bars. Requiring the chart
// timeframe to be <= the selected primary scope avoids sampling lower-timeframe
// OHLC through request.security() and preserves the original developing behavior.
float chart_tf_seconds = timeframe.in_seconds()
float target_tf_seconds = timeframe.in_seconds(target_tf)
if chart_tf_seconds > target_tf_seconds
    runtime.error("Chart timeframe must be <= the selected Active Timeframe Scope. Example: Hour mode requires a 60-minute-or-lower chart.")

g_data = "ATR & Range"

l1_basis = input.string(

     "High",

     title="Line 1 Price Basis",

     options=["Open", "High", "Low", "Close"],

     group=g_data,

     tooltip="OHLC value from the selected Week/Day/Hour period used for Line 1.")

l2_basis = input.string(

     "Low",

     title="Line 2 Price Basis",

     options=["Open", "High", "Low", "Close"],

     group=g_data,

     tooltip="OHLC value from the selected Week/Day/Hour period used for Line 2.")

range_method = input.string(

     "90th Percentile",

     title="Range Statistic",

     options=["Avg", "90th Percentile", "Max"],

     group=g_data,

     tooltip="Avg = arithmetic mean True Range over the selected scope lookback. 90th Percentile = defensive default that ignores only the most extreme tail. Max = most conservative observed True Range in the window. All calculations use completed bars only on the selected H/D/W scope.")

range_mult = input.float(

     1.0,

     title="Range Multiplier",

     minval=0.01,

     step=0.05,

     group=g_data,

     tooltip="Scales the selected True Range statistic around Current Price. 1.0 uses the statistic directly; values above 1.0 add an additional defensive buffer.")

hour_lookback = input.int(

     70,

     title="Hourly Lookback",

     minval=5,

     group=g_data,

     active=tf_mode == "Hour",

     tooltip="Number of completed 60-minute bars used in Hour mode. Default 70 is roughly two regular U.S. equity trading weeks and is intentionally defensive against week-to-week volatility shifts.")

day_lookback = input.int(

     21,

     title="Daily Lookback",

     minval=5,

     group=g_data,

     active=tf_mode == "Day",

     tooltip="Number of completed Daily bars used in Day mode. Default 21 is approximately one trading month, reducing the chance that a single quiet week contracts the range too quickly.")

week_lookback = input.int(

     13,

     title="Weekly Lookback",

     minval=5,

     group=g_data,

     active=tf_mode == "Week",

     tooltip="Number of completed Weekly bars used in Week mode. Default 13 is approximately one quarter, balancing structural context against stale volatility regimes.")

int active_range_lookback = switch tf_mode
    "Hour" => hour_lookback
    "Day"  => day_lookback
    "Week" => week_lookback
    => week_lookback

//====================================================================

// OPTIONAL PROBABILITY BAND SETTINGS

//====================================================================

g_prob = "Probability Bands (Optional / Independent)"

prob_source = input.string(

     "Historical Empirical",

     title="Probability Model",

     options=["Historical Empirical", "Manual IV (Static)"],

     group=g_prob,

     tooltip="Historical Empirical is the automatic default and uses completed daily log-return quantiles. Manual IV (Static) uses the IV value entered below; it does not read live option-chain IV.")

prob_horizon_days = input.int(

     1,

     title="Probability Horizon (Days)",

     minval=1,

     maxval=365,

     group=g_prob,

     tooltip="Historical mode interprets this as daily trading bars. Manual IV mode uses calendar-day scaling with sqrt(days/365).")

prob_lookback = input.int(

     252,

     title="Historical Lookback (Daily Bars)",

     minval=30,

     maxval=2000,

     group=g_prob,

     active=prob_source == "Historical Empirical",

     tooltip="Number of daily observations used to estimate empirical return quantiles. 252 is approximately one trading year.")

manual_iv_pct = input.float(

     25.0,

     title="Manual Annualized IV (%)",

     minval=0.1,

     step=0.1,

     group=g_prob,

     active=prob_source == "Manual IV (Static)",

     tooltip="Used only with Manual IV (Static). Enter annualized option-chain IV, for example 25 for 25%. Update it manually when IV changes.")

//====================================================================

// LABEL OPTIONS

//====================================================================

g_labels = "Labels"

show_desc = input.bool(

     true,

     title="Show Description",

     group=g_labels,

     tooltip="Shows the line meaning/model in each label. Turn off for price-only labels.")

show_price = input.bool(

     true,

     title="Show Price Values",

     group=g_labels,

     tooltip="Shows the numerical price next to each enabled label.")

lbl_just = input.string(

     "Right",

     title="Label Position",

     options=["Left", "Center", "Right"],

     group=g_labels,

     tooltip="Positions labels at the start, midpoint, or right edge of the displayed horizontal line.")

lbl_size = input.string(

     "Small",

     title="Font Size",

     options=["Tiny", "Small", "Normal", "Large", "Huge"],

     group=g_labels)

parsed_size = switch lbl_size

    "Tiny"   => size.tiny

    "Small"  => size.small

    "Normal" => size.normal

    "Large"  => size.large

    "Huge"   => size.huge

    => size.small

//====================================================================

// LINE STYLE OPTIONS

//====================================================================

g1 = "Line 1 Style Options"

show_l1 = input.bool(true, title="Show Line 1", inline="l1", group=g1)

c_l1    = input.color(color.blue, title="", inline="l1", group=g1)

w_l1    = input.int(2, title="Width", minval=1, inline="l1", group=g1)

s_l1    = input.string(line.style_solid, title="", options=[line.style_solid, line.style_dashed, line.style_dotted], inline="l1", group=g1)

g2 = "Line 2 Style Options"

show_l2 = input.bool(true, title="Show Line 2", inline="l2", group=g2)

c_l2    = input.color(color.orange, title="", inline="l2", group=g2)

w_l2    = input.int(2, title="Width", minval=1, inline="l2", group=g2)

s_l2    = input.string(line.style_solid, title="", options=[line.style_solid, line.style_dashed, line.style_dotted], inline="l2", group=g2)

g3 = "Range Upper"

show_l3 = input.bool(true, title="Show Upper Range", inline="l3", group=g3)

c_l3    = input.color(color.green, title="", inline="l3", group=g3)

w_l3    = input.int(2, title="Width", minval=1, inline="l3", group=g3)

s_l3    = input.string(line.style_solid, title="", options=[line.style_solid, line.style_dashed, line.style_dotted], inline="l3", group=g3)

g4 = "Range Lower"

show_l4 = input.bool(true, title="Show Lower Range", inline="l4", group=g4)

c_l4    = input.color(color.red, title="", inline="l4", group=g4)

w_l4    = input.int(2, title="Width", minval=1, inline="l4", group=g4)

s_l4    = input.string(line.style_solid, title="", options=[line.style_solid, line.style_dashed, line.style_dotted], inline="l4", group=g4)

g5 = "Current Price"

show_basis = input.bool(true, title="Show Current Price", inline="basis", group=g5)

c_basis    = input.color(color.gray, title="", inline="basis", group=g5)

w_basis    = input.int(1, title="Width", minval=1, inline="basis", group=g5)

s_basis    = input.string(line.style_dotted, title="", options=[line.style_solid, line.style_dashed, line.style_dotted], inline="basis", group=g5)

// Probability ranges are drawing objects, so appearance is controlled here
// rather than exposing redundant automatic Style-tab controls.

g68 = "Probability 68%"
show_p68 = input.bool(false, title="Show 68% Band", inline="p68", group=g68)
c_p68 = input.color(color.aqua, title="", inline="p68", group=g68)
w_p68 = input.int(2, title="Width", minval=1, maxval=5, inline="p68", group=g68)
s_p68 = input.string(line.style_solid, title="", options=[line.style_solid, line.style_dashed, line.style_dotted], inline="p68", group=g68)
fill_p68 = input.int(88, title="Fill Transparency", minval=0, maxval=100, group=g68, tooltip="0 = opaque fill; 100 = no fill.")

g90 = "Probability 90%"
show_p90 = input.bool(false, title="Show 90% Band", inline="p90", group=g90)
c_p90 = input.color(color.orange, title="", inline="p90", group=g90)
w_p90 = input.int(2, title="Width", minval=1, maxval=5, inline="p90", group=g90)
s_p90 = input.string(line.style_dashed, title="", options=[line.style_solid, line.style_dashed, line.style_dotted], inline="p90", group=g90)
fill_p90 = input.int(92, title="Fill Transparency", minval=0, maxval=100, group=g90, tooltip="0 = opaque fill; 100 = no fill.")

g95 = "Probability 95%"
show_p95 = input.bool(false, title="Show 95% Band", inline="p95", group=g95)
c_p95 = input.color(color.purple, title="", inline="p95", group=g95)
w_p95 = input.int(2, title="Width", minval=1, maxval=5, inline="p95", group=g95)
s_p95 = input.string(line.style_dotted, title="", options=[line.style_solid, line.style_dashed, line.style_dotted], inline="p95", group=g95)
fill_p95 = input.int(95, title="Fill Transparency", minval=0, maxval=100, group=g95, tooltip="0 = opaque fill; 100 = no fill.")

//====================================================================

// PRIMARY-PERIOD OHLC TRACKING

//

// IMPORTANT DESIGN:

// Current-period OHLC is built directly from chart bars for the selected
// Week/Day/Hour target timeframe. At each real target-period boundary the
// completed period shifts into Previous / -2 / -3 slots. No rolling-date
// arithmetic is used. Current-period High/Low/Close develop in real time.

//====================================================================

bool new_target_period = timeframe.change(target_tf)

int target_period_start = time(target_tf)

// Current active target period.

var int   cur_start = na

var float cur_open  = na

var float cur_high  = na

var float cur_low   = na

var float cur_close = na

// Previous 1, 2, 3 completed target periods.

var int   p1_start = na

var float p1_open  = na

var float p1_high  = na

var float p1_low   = na

var float p1_close = na

var int   p2_start = na

var float p2_open  = na

var float p2_high  = na

var float p2_low   = na

var float p2_close = na

var int   p3_start = na

var float p3_open  = na

var float p3_high  = na

var float p3_low   = na

var float p3_close = na

if barstate.isfirst

    cur_start := target_period_start

    cur_open  := open

    cur_high  := high

    cur_low   := low

    cur_close := close

else if new_target_period

    // Shift completed periods.

    p3_start := p2_start

    p3_open  := p2_open

    p3_high  := p2_high

    p3_low   := p2_low

    p3_close := p2_close

    p2_start := p1_start

    p2_open  := p1_open

    p2_high  := p1_high

    p2_low   := p1_low

    p2_close := p1_close

    p1_start := cur_start

    p1_open  := cur_open

    p1_high  := cur_high

    p1_low   := cur_low

    p1_close := cur_close

    // Start the new active period.

    cur_start := target_period_start

    cur_open  := open

    cur_high  := high

    cur_low   := low

    cur_close := close

else

    // Develop current-period OHLC in real time.

    cur_high  := na(cur_high) ? high : math.max(cur_high, high)

    cur_low   := na(cur_low) ? low : math.min(cur_low, low)

    cur_close := close

//====================================================================

// DEFENSIVE TRUE RANGE STATISTICS

//

// The selected H/D/W scope is self-contained:
//   Hour = 60-minute True Range only.
//   Day  = Daily True Range only.
//   Week = Weekly True Range only.
// No sub-timeframe ATR is requested or blended. The population uses completed
// target-timeframe bars only, so its Avg/P90/Max values are stable throughout
// the developing current scope bar. request.security() uses lookahead_on safely
// because get_confirmed_tr_stats() offsets True Range by one target bar.

//====================================================================

[range_avg_tr, range_p90_tr, range_max_tr] = request.security(

     syminfo.tickerid,

     target_tf,

     get_confirmed_tr_stats(active_range_lookback),

     barmerge.gaps_off,

     barmerge.lookahead_on)

//====================================================================

// RESOLVE THE ACTIVE PERIOD

//====================================================================

float sel_open = switch period_offset

    0 => cur_open

    1 => p1_open

    2 => p2_open

    3 => p3_open

    => cur_open

float sel_high = switch period_offset

    0 => cur_high

    1 => p1_high

    2 => p2_high

    3 => p3_high

    => cur_high

float sel_low = switch period_offset

    0 => cur_low

    1 => p1_low

    2 => p2_low

    3 => p3_low

    => cur_low

float sel_close = switch period_offset

    0 => cur_close

    1 => p1_close

    2 => p2_close

    3 => p3_close

    => cur_close

int sel_start = switch period_offset

    0 => cur_start

    1 => p1_start

    2 => p2_start

    3 => p3_start

    => cur_start

//====================================================================

// PROBABILITY BAND CALCULATION

// These calculations are intentionally isolated from defensive range logic: they never
// feed target_tf, period_offset, selected OHLC, or True Range statistics.
// They only produce optional forward-looking display bands around live close.

//====================================================================

// Historical Empirical mode uses only completed Daily closes. For a horizon N,
// each observation is log(close[t] / close[t-N]); the central intervals are the
// empirical 16/84, 5/95, and 2.5/97.5 percentiles for 68%, 90%, and 95%.
// This deliberately preserves observed skew/fat tails instead of forcing a
// normal distribution. The quantiles remain fixed intraday, but the displayed
// price bands move with live close because Current Price is always the anchor.
//
// Manual IV (Static) assumes normally distributed log returns with zero drift.
// Annualized IV is scaled by sqrt(calendar days / 365), then mapped with the
// standard z levels for 68%, 90%, and 95% central ranges. The entered IV does
// NOT update from TradingView's option chain; the user must refresh it manually.
// Both models are ranges/estimates, not guarantees of future containment.

[daily_q16, daily_q84, daily_q05, daily_q95, daily_q025, daily_q975] = request.security(
     syminfo.tickerid,
     "1D",
     [
          ta.percentile_linear_interpolation(math.log(close[1] / close[prob_horizon_days + 1]), prob_lookback, 16.0),
          ta.percentile_linear_interpolation(math.log(close[1] / close[prob_horizon_days + 1]), prob_lookback, 84.0),
          ta.percentile_linear_interpolation(math.log(close[1] / close[prob_horizon_days + 1]), prob_lookback, 5.0),
          ta.percentile_linear_interpolation(math.log(close[1] / close[prob_horizon_days + 1]), prob_lookback, 95.0),
          ta.percentile_linear_interpolation(math.log(close[1] / close[prob_horizon_days + 1]), prob_lookback, 2.5),
          ta.percentile_linear_interpolation(math.log(close[1] / close[prob_horizon_days + 1]), prob_lookback, 97.5)
     ],
     barmerge.gaps_off,
     barmerge.lookahead_off)

// Live close is the single center for defensive range and probability bands.
// This is intentionally independent of Day High/Low and any prior-period value.
float prob_anchor = close

// Option-style volatility scaling for the static-IV model.
float iv_sigma_horizon = (manual_iv_pct / 100.0) * math.sqrt(prob_horizon_days / 365.0)
float z68 = 1.0
float z90 = 1.64485362695147
float z95 = 1.95996398454005

float p68_lower_return = prob_source == "Manual IV (Static)" ? -z68 * iv_sigma_horizon : daily_q16
float p68_upper_return = prob_source == "Manual IV (Static)" ?  z68 * iv_sigma_horizon : daily_q84
float p90_lower_return = prob_source == "Manual IV (Static)" ? -z90 * iv_sigma_horizon : daily_q05
float p90_upper_return = prob_source == "Manual IV (Static)" ?  z90 * iv_sigma_horizon : daily_q95
float p95_lower_return = prob_source == "Manual IV (Static)" ? -z95 * iv_sigma_horizon : daily_q025
float p95_upper_return = prob_source == "Manual IV (Static)" ?  z95 * iv_sigma_horizon : daily_q975

float p68_low = na(p68_lower_return) ? na : prob_anchor * math.exp(p68_lower_return)
float p68_high = na(p68_upper_return) ? na : prob_anchor * math.exp(p68_upper_return)
float p90_low = na(p90_lower_return) ? na : prob_anchor * math.exp(p90_lower_return)
float p90_high = na(p90_upper_return) ? na : prob_anchor * math.exp(p90_upper_return)
float p95_low = na(p95_lower_return) ? na : prob_anchor * math.exp(p95_lower_return)
float p95_high = na(p95_upper_return) ? na : prob_anchor * math.exp(p95_upper_return)

string prob_source_text = prob_source == "Manual IV (Static)" ? "Manual IV " + str.tostring(manual_iv_pct, "#.##") + "%" : "Historical Empirical"

//====================================================================

// GRAPHIC CONTAINERS

//====================================================================

var line l1 = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right)

var label lbl1 = label.new(na, na, text="", xloc=xloc.bar_time, style=label.style_none)

var line l2 = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right)

var label lbl2 = label.new(na, na, text="", xloc=xloc.bar_time, style=label.style_none)

var line l3 = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right)

var label lbl3 = label.new(na, na, text="", xloc=xloc.bar_time, style=label.style_none)

var line l4 = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right)

var label lbl4 = label.new(na, na, text="", xloc=xloc.bar_time, style=label.style_none)

var line l_basis = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right)

var label lbl_basis = label.new(na, na, text="", xloc=xloc.bar_time, style=label.style_none)

var line l_p68_hi = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right)
var label lbl_p68_hi = label.new(na, na, text="", xloc=xloc.bar_time, style=label.style_none)
var line l_p68_lo = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right)
var label lbl_p68_lo = label.new(na, na, text="", xloc=xloc.bar_time, style=label.style_none)
var linefill fill68 = linefill.new(l_p68_hi, l_p68_lo, color.new(c_p68, fill_p68))

var line l_p90_hi = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right)
var label lbl_p90_hi = label.new(na, na, text="", xloc=xloc.bar_time, style=label.style_none)
var line l_p90_lo = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right)
var label lbl_p90_lo = label.new(na, na, text="", xloc=xloc.bar_time, style=label.style_none)
var linefill fill90 = linefill.new(l_p90_hi, l_p90_lo, color.new(c_p90, fill_p90))

var line l_p95_hi = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right)
var label lbl_p95_hi = label.new(na, na, text="", xloc=xloc.bar_time, style=label.style_none)
var line l_p95_lo = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right)
var label lbl_p95_lo = label.new(na, na, text="", xloc=xloc.bar_time, style=label.style_none)
var linefill fill95 = linefill.new(l_p95_hi, l_p95_lo, color.new(c_p95, fill_p95))

//====================================================================

// RENDER

//====================================================================

if barstate.islast

    float base_range = switch range_method

        "Avg" => range_avg_tr

        "90th Percentile" => range_p90_tr

        "Max" => range_max_tr

        => range_p90_tr

    float final_range = base_range * range_mult

    float val_l1 = get_selected_value(l1_basis, sel_open, sel_high, sel_low, sel_close)

    float val_l2 = get_selected_value(l2_basis, sel_open, sel_high, sel_low, sel_close)

    // Defensive range bands are always centered on live close. The selected
    // historical/current reference period affects Line 1/Line 2 only; it does
    // not change the H/D/W range population or move the Current Price anchor.

    float anchor_price = close

    string anchor_label = "Current Price"

    // Exact symmetric defensive range bands.

    float val_range_h = anchor_price + final_range

    float val_range_l = anchor_price - final_range

    string range_component_text =

         tf_code + " " + str.tostring(active_range_lookback) + " bars"

    string range_mode_text =

         range_method + " TR x " + str.tostring(range_mult, "#.##")

    string basis_text = ""

    if show_desc

        basis_text := "Current Price"

    basis_text := basis_text +

         (basis_text == "" ? "" : " | ") +

         "Range Used: " + str.tostring(final_range, format.mintick) +

         " [" + range_component_text + ", " + range_method + "]"

    if show_price

        basis_text := basis_text + " | Basis: " + str.tostring(anchor_price, format.mintick)

    int label_x_pos = timenow

    string label_align = text.align_right

    if lbl_just == "Left"

        label_x_pos := sel_start

        label_align := text.align_left

    else if lbl_just == "Center"

        label_x_pos := int(math.avg(sel_start, timenow))

        label_align := text.align_center

    // Current Price and defensive range lines belong to the CURRENT selected
    // H/D/W period, regardless of which prior period Line 1/Line 2 reference.
    int range_start = cur_start
    int range_label_x_pos = timenow
    if lbl_just == "Left"
        range_label_x_pos := range_start
    else if lbl_just == "Center"
        range_label_x_pos := int(math.avg(range_start, timenow))

    // -------------------------

    // Line 1

    // -------------------------

    line.set_color(l1, c_l1)

    line.set_width(l1, w_l1)

    line.set_style(l1, s_l1)

    label.set_textcolor(lbl1, c_l1)

    label.set_size(lbl1, parsed_size)

    label.set_textalign(lbl1, label_align)

    if show_l1 and not na(sel_start) and not na(val_l1)

        line.set_xy1(l1, sel_start, val_l1)

        line.set_xy2(l1, timenow, val_l1)

        if show_desc or show_price

            label.set_xy(lbl1, label_x_pos, val_l1)

            label.set_text(lbl1, get_label_text(show_desc, active_select + " " + l1_basis, show_price, val_l1))

        else

            label.set_xy(lbl1, na, na)

    else

        line.set_xy1(l1, na, na)

        line.set_xy2(l1, na, na)

        label.set_xy(lbl1, na, na)

    // -------------------------

    // Line 2

    // -------------------------

    line.set_color(l2, c_l2)

    line.set_width(l2, w_l2)

    line.set_style(l2, s_l2)

    label.set_textcolor(lbl2, c_l2)

    label.set_size(lbl2, parsed_size)

    label.set_textalign(lbl2, label_align)

    if show_l2 and not na(sel_start) and not na(val_l2)

        line.set_xy1(l2, sel_start, val_l2)

        line.set_xy2(l2, timenow, val_l2)

        if show_desc or show_price

            label.set_xy(lbl2, label_x_pos, val_l2)

            label.set_text(lbl2, get_label_text(show_desc, active_select + " " + l2_basis, show_price, val_l2))

        else

            label.set_xy(lbl2, na, na)

    else

        line.set_xy1(l2, na, na)

        line.set_xy2(l2, na, na)

        label.set_xy(lbl2, na, na)

    // -------------------------

    // Current Price

    // -------------------------

    line.set_color(l_basis, c_basis)

    line.set_width(l_basis, w_basis)

    line.set_style(l_basis, s_basis)

    label.set_textcolor(lbl_basis, c_basis)

    label.set_size(lbl_basis, parsed_size)

    label.set_textalign(lbl_basis, label_align)

    if show_basis and not na(range_start) and not na(anchor_price)

        line.set_xy1(l_basis, range_start, anchor_price)

        line.set_xy2(l_basis, timenow, anchor_price)

        label.set_xy(lbl_basis, range_label_x_pos, anchor_price)

        label.set_text(lbl_basis, basis_text)

    else

        line.set_xy1(l_basis, na, na)

        line.set_xy2(l_basis, na, na)

        label.set_xy(lbl_basis, na, na)

    // -------------------------

    // Upper defensive range

    // -------------------------

    line.set_color(l3, c_l3)

    line.set_width(l3, w_l3)

    line.set_style(l3, s_l3)

    label.set_textcolor(lbl3, c_l3)

    label.set_size(lbl3, parsed_size)

    label.set_textalign(lbl3, label_align)

    if show_l3 and not na(range_start) and not na(val_range_h)

        line.set_xy1(l3, range_start, val_range_h)

        line.set_xy2(l3, timenow, val_range_h)

        if show_desc or show_price

            label.set_xy(lbl3, range_label_x_pos, val_range_h)

            label.set_text(

                 lbl3,

                 get_label_text(

                      show_desc,

                      "Range Upper (" + anchor_label + " + " + range_mode_text + ")",

                      show_price,

                      val_range_h))

        else

            label.set_xy(lbl3, na, na)

    else

        line.set_xy1(l3, na, na)

        line.set_xy2(l3, na, na)

        label.set_xy(lbl3, na, na)

    // -------------------------

    // Lower defensive range

    // -------------------------

    line.set_color(l4, c_l4)

    line.set_width(l4, w_l4)

    line.set_style(l4, s_l4)

    label.set_textcolor(lbl4, c_l4)

    label.set_size(lbl4, parsed_size)

    label.set_textalign(lbl4, label_align)

    if show_l4 and not na(range_start) and not na(val_range_l)

        line.set_xy1(l4, range_start, val_range_l)

        line.set_xy2(l4, timenow, val_range_l)

        if show_desc or show_price

            label.set_xy(lbl4, range_label_x_pos, val_range_l)

            label.set_text(

                 lbl4,

                 get_label_text(

                      show_desc,

                      "Range Lower (" + anchor_label + " - " + range_mode_text + ")",

                      show_price,

                      val_range_l))

        else

            label.set_xy(lbl4, na, na)

    else

        line.set_xy1(l4, na, na)

        line.set_xy2(l4, na, na)

        label.set_xy(lbl4, na, na)

    // -------------------------

    // Probability bands

    // -------------------------

    // Probability lines begin on the current chart bar and extend right.
    // They are intentionally not drawn backward because the range is a
    // forward-looking projection anchored to the current live price.
    int prob_start = time
    int prob_label_x_pos = timenow
    if lbl_just == "Left"
        prob_label_x_pos := prob_start
    else if lbl_just == "Center"
        prob_label_x_pos := int(math.avg(prob_start, timenow))
    string prob_horizon_text = str.tostring(prob_horizon_days) + "D"

    line.set_color(l_p68_hi, c_p68)
    line.set_width(l_p68_hi, w_p68)
    line.set_style(l_p68_hi, s_p68)
    line.set_color(l_p68_lo, c_p68)
    line.set_width(l_p68_lo, w_p68)
    line.set_style(l_p68_lo, s_p68)
    label.set_textcolor(lbl_p68_hi, c_p68)
    label.set_textcolor(lbl_p68_lo, c_p68)
    label.set_size(lbl_p68_hi, parsed_size)
    label.set_size(lbl_p68_lo, parsed_size)
    label.set_textalign(lbl_p68_hi, label_align)
    label.set_textalign(lbl_p68_lo, label_align)
    linefill.set_color(fill68, show_p68 ? color.new(c_p68, fill_p68) : color.new(c_p68, 100))

    if show_p68 and not na(p68_high) and not na(p68_low)
        line.set_xy1(l_p68_hi, prob_start, p68_high)
        line.set_xy2(l_p68_hi, timenow, p68_high)
        line.set_xy1(l_p68_lo, prob_start, p68_low)
        line.set_xy2(l_p68_lo, timenow, p68_low)
        if show_desc or show_price
            label.set_xy(lbl_p68_hi, prob_label_x_pos, p68_high)
            label.set_text(lbl_p68_hi, get_label_text(show_desc, "68% Prob Upper (" + prob_source_text + ", " + prob_horizon_text + ")", show_price, p68_high))
            label.set_xy(lbl_p68_lo, prob_label_x_pos, p68_low)
            label.set_text(lbl_p68_lo, get_label_text(show_desc, "68% Prob Lower (" + prob_source_text + ", " + prob_horizon_text + ")", show_price, p68_low))
        else
            label.set_xy(lbl_p68_hi, na, na)
            label.set_xy(lbl_p68_lo, na, na)
    else
        line.set_xy1(l_p68_hi, na, na)
        line.set_xy2(l_p68_hi, na, na)
        line.set_xy1(l_p68_lo, na, na)
        line.set_xy2(l_p68_lo, na, na)
        label.set_xy(lbl_p68_hi, na, na)
        label.set_xy(lbl_p68_lo, na, na)

    line.set_color(l_p90_hi, c_p90)
    line.set_width(l_p90_hi, w_p90)
    line.set_style(l_p90_hi, s_p90)
    line.set_color(l_p90_lo, c_p90)
    line.set_width(l_p90_lo, w_p90)
    line.set_style(l_p90_lo, s_p90)
    label.set_textcolor(lbl_p90_hi, c_p90)
    label.set_textcolor(lbl_p90_lo, c_p90)
    label.set_size(lbl_p90_hi, parsed_size)
    label.set_size(lbl_p90_lo, parsed_size)
    label.set_textalign(lbl_p90_hi, label_align)
    label.set_textalign(lbl_p90_lo, label_align)
    linefill.set_color(fill90, show_p90 ? color.new(c_p90, fill_p90) : color.new(c_p90, 100))

    if show_p90 and not na(p90_high) and not na(p90_low)
        line.set_xy1(l_p90_hi, prob_start, p90_high)
        line.set_xy2(l_p90_hi, timenow, p90_high)
        line.set_xy1(l_p90_lo, prob_start, p90_low)
        line.set_xy2(l_p90_lo, timenow, p90_low)
        if show_desc or show_price
            label.set_xy(lbl_p90_hi, prob_label_x_pos, p90_high)
            label.set_text(lbl_p90_hi, get_label_text(show_desc, "90% Prob Upper (" + prob_source_text + ", " + prob_horizon_text + ")", show_price, p90_high))
            label.set_xy(lbl_p90_lo, prob_label_x_pos, p90_low)
            label.set_text(lbl_p90_lo, get_label_text(show_desc, "90% Prob Lower (" + prob_source_text + ", " + prob_horizon_text + ")", show_price, p90_low))
        else
            label.set_xy(lbl_p90_hi, na, na)
            label.set_xy(lbl_p90_lo, na, na)
    else
        line.set_xy1(l_p90_hi, na, na)
        line.set_xy2(l_p90_hi, na, na)
        line.set_xy1(l_p90_lo, na, na)
        line.set_xy2(l_p90_lo, na, na)
        label.set_xy(lbl_p90_hi, na, na)
        label.set_xy(lbl_p90_lo, na, na)

    line.set_color(l_p95_hi, c_p95)
    line.set_width(l_p95_hi, w_p95)
    line.set_style(l_p95_hi, s_p95)
    line.set_color(l_p95_lo, c_p95)
    line.set_width(l_p95_lo, w_p95)
    line.set_style(l_p95_lo, s_p95)
    label.set_textcolor(lbl_p95_hi, c_p95)
    label.set_textcolor(lbl_p95_lo, c_p95)
    label.set_size(lbl_p95_hi, parsed_size)
    label.set_size(lbl_p95_lo, parsed_size)
    label.set_textalign(lbl_p95_hi, label_align)
    label.set_textalign(lbl_p95_lo, label_align)
    linefill.set_color(fill95, show_p95 ? color.new(c_p95, fill_p95) : color.new(c_p95, 100))

    if show_p95 and not na(p95_high) and not na(p95_low)
        line.set_xy1(l_p95_hi, prob_start, p95_high)
        line.set_xy2(l_p95_hi, timenow, p95_high)
        line.set_xy1(l_p95_lo, prob_start, p95_low)
        line.set_xy2(l_p95_lo, timenow, p95_low)
        if show_desc or show_price
            label.set_xy(lbl_p95_hi, prob_label_x_pos, p95_high)
            label.set_text(lbl_p95_hi, get_label_text(show_desc, "95% Prob Upper (" + prob_source_text + ", " + prob_horizon_text + ")", show_price, p95_high))
            label.set_xy(lbl_p95_lo, prob_label_x_pos, p95_low)
            label.set_text(lbl_p95_lo, get_label_text(show_desc, "95% Prob Lower (" + prob_source_text + ", " + prob_horizon_text + ")", show_price, p95_low))
        else
            label.set_xy(lbl_p95_hi, na, na)
            label.set_xy(lbl_p95_lo, na, na)
    else
        line.set_xy1(l_p95_hi, na, na)
        line.set_xy2(l_p95_hi, na, na)
        line.set_xy1(l_p95_lo, na, na)
        line.set_xy2(l_p95_lo, na, na)
        label.set_xy(lbl_p95_hi, na, na)
        label.set_xy(lbl_p95_lo, na, na)

