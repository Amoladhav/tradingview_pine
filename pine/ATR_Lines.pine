//@version=6

// Revision: 1.04

// Changelog:
// 1.04 - Simplified the indicator around completed True Range statistics only.
//        Removed obsolete Week/Day/Hour historical-period selectors and Line 1/Line 2.
//        Removed Range Multiplier and the separate forward probability-band model.
//        Added independent Min, Avg, 90th Percentile, and Max range-statistic toggles.
//        Range labels now include the active calculation timeframe (60m, 1D, or 1W).
// 1.03 - Reworked the defensive range calculation for covered-call strike context.
//        H/D/W now use only their own completed True Range bars: H=70, D=21, W=13
//        by default. Range statistic choices are Avg, 90th percentile, and Max.
//        Removed all sub-timeframe ATR blending; probability bands remain independent.
// 1.02 - Restored Week/Day/Hour scope and completed-period selectors for ATR/range
//        calculations. ATR remains anchored to live close. Probability bands are
//        independent of ATR logic and are off by default.
// 1.01 - Added source-level documentation and tooltips for the fixed current-day
//        scope, live-price anchoring, ATR blend, and probability-band models.
//        No calculation, alert, or timeframe behavior was changed.

indicator("ATR Lines", shorttitle="ATR Lines", overlay=true, max_lines_count=20, max_labels_count=20)

//====================================================================
// HELPERS
//====================================================================

get_label_text(show_d, d_text, show_p, p_val) =>
    string out = ""
    if show_d
        out := d_text
    if show_p
        out := out + (show_d ? " : " : "") + str.tostring(p_val, format.mintick)
    out

// Computes defensive True Range statistics from COMPLETED bars only on the
// requested scope. Shifting True Range by one target-timeframe bar prevents the
// developing current H/D/W bar from biasing the population. The 90th percentile
// uses linear interpolation so it remains defensive without collapsing to Max.
get_confirmed_tr_stats(_lookback) =>
    float raw_tr = ta.tr(true)
    float confirmed_tr = raw_tr[1]
    float min_tr = ta.lowest(confirmed_tr, _lookback)
    float avg_tr = ta.sma(confirmed_tr, _lookback)
    float p90_tr = ta.percentile_linear_interpolation(confirmed_tr, _lookback, 90.0)
    float max_tr = ta.highest(confirmed_tr, _lookback)
    [min_tr, avg_tr, p90_tr, max_tr]

//====================================================================
// USER SETTINGS
//====================================================================

// The selected scope controls only the completed True Range population.
// Hour uses 60-minute bars, Day uses Daily bars, and Week uses Weekly bars.
// No lower/sub-timeframe True Range data is mixed into the selected scope.
// Every enabled range statistic is centered on the live Current Price.
g_mode = "Timeframe Mode"

tf_mode = input.string(
     "Week",
     title="Active Timeframe Scope",
     options=["Week", "Day", "Hour"],
     group=g_mode,
     tooltip="Selects the completed True Range population. Hour = 60-minute bars, Day = Daily bars, Week = Weekly bars. No sub-timeframe data is blended. All enabled ranges remain centered on live Current Price.")

string target_tf = switch tf_mode
    "Week" => "1W"
    "Day"  => "1D"
    "Hour" => "60"
    => "1W"

string tf_label = switch tf_mode
    "Week" => "1W"
    "Day"  => "1D"
    "Hour" => "60m"
    => "1W"

// Preserve the existing timeframe-safety rule: the chart must not be above the
// selected calculation scope because this indicator is intended to render the
// active scope directly on an equal-or-lower chart timeframe.
float chart_tf_seconds = timeframe.in_seconds()
float target_tf_seconds = timeframe.in_seconds(target_tf)

if chart_tf_seconds > target_tf_seconds
    runtime.error("Chart timeframe must be <= the selected Active Timeframe Scope. Example: Hour mode requires a 60-minute-or-lower chart.")

g_data = "ATR & Range"

show_range_min = input.bool(
     false,
     title="Min",
     inline="range_stats",
     group=g_data,
     tooltip="Shows the minimum completed True Range observed in the active lookback. This is the least defensive range statistic.")

show_range_avg = input.bool(
     false,
     title="Avg",
     inline="range_stats",
     group=g_data,
     tooltip="Shows the arithmetic mean of completed True Range over the active lookback.")

show_range_p90 = input.bool(
     true,
     title="90th Percentile",
     inline="range_stats",
     group=g_data,
     tooltip="Shows the 90th percentile of completed True Range over the active lookback. Enabled by default as the defensive range reference.")

show_range_max = input.bool(
     false,
     title="Max",
     inline="range_stats",
     group=g_data,
     tooltip="Shows the maximum completed True Range observed in the active lookback. This is the most conservative observed range statistic.")

hour_lookback = input.int(
     70,
     title="Hourly Lookback",
     minval=5,
     group=g_data,
     active=tf_mode == "Hour",
     tooltip="Number of completed 60-minute bars used in Hour mode. Default 70 is roughly two regular U.S. equity trading weeks and is intentionally defensive against week-to-week volatility shifts.")

day_lookback = input.int(
     21,
     title="Daily Lookback",
     minval=5,
     group=g_data,
     active=tf_mode == "Day",
     tooltip="Number of completed Daily bars used in Day mode. Default 21 is approximately one trading month, reducing the chance that a single quiet week contracts the range too quickly.")

week_lookback = input.int(
     13,
     title="Weekly Lookback",
     minval=5,
     group=g_data,
     active=tf_mode == "Week",
     tooltip="Number of completed Weekly bars used in Week mode. Default 13 is approximately one quarter, balancing structural context against stale volatility regimes.")

int active_range_lookback = switch tf_mode
    "Hour" => hour_lookback
    "Day"  => day_lookback
    "Week" => week_lookback
    => week_lookback

//====================================================================
// LABEL OPTIONS
//====================================================================

g_labels = "Labels"

show_desc = input.bool(
     true,
     title="Show Description",
     group=g_labels,
     tooltip="Shows the statistic, side, calculation timeframe, and lookback in each enabled range label.")

show_price = input.bool(
     true,
     title="Show Price Values",
     group=g_labels,
     tooltip="Shows the numerical price next to each enabled label.")

lbl_just = input.string(
     "Right",
     title="Label Position",
     options=["Left", "Center", "Right"],
     group=g_labels,
     tooltip="Positions labels at the start, midpoint, or right edge of the displayed horizontal line.")

lbl_size = input.string(
     "Small",
     title="Font Size",
     options=["Tiny", "Small", "Normal", "Large", "Huge"],
     group=g_labels)

parsed_size = switch lbl_size
    "Tiny"   => size.tiny
    "Small"  => size.small
    "Normal" => size.normal
    "Large"  => size.large
    "Huge"   => size.huge
    => size.small

//====================================================================
// LINE STYLE OPTIONS
//====================================================================

// Upper/lower appearance remains common to all enabled range statistics. The
// statistic toggles above determine which Min/Avg/P90/Max pairs are rendered.
g_upper = "Range Upper"
show_upper = input.bool(true, title="Show Upper Range", inline="upper", group=g_upper)
c_upper = input.color(color.green, title="", inline="upper", group=g_upper)
w_upper = input.int(2, title="Width", minval=1, inline="upper", group=g_upper)
s_upper = input.string(line.style_solid, title="", options=[line.style_solid, line.style_dashed, line.style_dotted], inline="upper", group=g_upper)

g_lower = "Range Lower"
show_lower = input.bool(true, title="Show Lower Range", inline="lower", group=g_lower)
c_lower = input.color(color.red, title="", inline="lower", group=g_lower)
w_lower = input.int(2, title="Width", minval=1, inline="lower", group=g_lower)
s_lower = input.string(line.style_solid, title="", options=[line.style_solid, line.style_dashed, line.style_dotted], inline="lower", group=g_lower)

g_basis = "Current Price"
show_basis = input.bool(true, title="Show Current Price", inline="basis", group=g_basis)
c_basis = input.color(color.gray, title="", inline="basis", group=g_basis)
w_basis = input.int(1, title="Width", minval=1, inline="basis", group=g_basis)
s_basis = input.string(line.style_dotted, title="", options=[line.style_solid, line.style_dashed, line.style_dotted], inline="basis", group=g_basis)

//====================================================================
// DEFENSIVE TRUE RANGE STATISTICS
//====================================================================

// request.security() preserves the existing scope behavior. lookahead_on is safe
// here because get_confirmed_tr_stats() explicitly shifts True Range by one full
// target-timeframe bar, so only completed target bars enter the population.
[range_min_tr, range_avg_tr, range_p90_tr, range_max_tr] = request.security(
     syminfo.tickerid,
     target_tf,
     get_confirmed_tr_stats(active_range_lookback),
     barmerge.gaps_off,
     barmerge.lookahead_on)

//====================================================================
// GRAPHIC CONTAINERS
//====================================================================

var line l_basis = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right)
var label lbl_basis = label.new(na, na, text="", xloc=xloc.bar_time, style=label.style_none)

var line l_min_hi = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right)
var label lbl_min_hi = label.new(na, na, text="", xloc=xloc.bar_time, style=label.style_none)
var line l_min_lo = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right)
var label lbl_min_lo = label.new(na, na, text="", xloc=xloc.bar_time, style=label.style_none)

var line l_avg_hi = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right)
var label lbl_avg_hi = label.new(na, na, text="", xloc=xloc.bar_time, style=label.style_none)
var line l_avg_lo = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right)
var label lbl_avg_lo = label.new(na, na, text="", xloc=xloc.bar_time, style=label.style_none)

var line l_p90_hi = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right)
var label lbl_p90_hi = label.new(na, na, text="", xloc=xloc.bar_time, style=label.style_none)
var line l_p90_lo = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right)
var label lbl_p90_lo = label.new(na, na, text="", xloc=xloc.bar_time, style=label.style_none)

var line l_max_hi = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right)
var label lbl_max_hi = label.new(na, na, text="", xloc=xloc.bar_time, style=label.style_none)
var line l_max_lo = line.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right)
var label lbl_max_lo = label.new(na, na, text="", xloc=xloc.bar_time, style=label.style_none)

//====================================================================
// RENDER
//====================================================================

if barstate.islast
    // All enabled range statistics use the same live-price anchor. Only the
    // completed True Range statistic changes between Min / Avg / P90 / Max.
    float anchor_price = close
    float val_min_hi = anchor_price + range_min_tr
    float val_min_lo = anchor_price - range_min_tr
    float val_avg_hi = anchor_price + range_avg_tr
    float val_avg_lo = anchor_price - range_avg_tr
    float val_p90_hi = anchor_price + range_p90_tr
    float val_p90_lo = anchor_price - range_p90_tr
    float val_max_hi = anchor_price + range_max_tr
    float val_max_lo = anchor_price - range_max_tr

    int range_start = time(target_tf)
    int range_label_x_pos = timenow
    string label_align = text.align_right

    if lbl_just == "Left"
        range_label_x_pos := range_start
        label_align := text.align_left
    else if lbl_just == "Center"
        range_label_x_pos := int(math.avg(range_start, timenow))
        label_align := text.align_center

    string lookback_text = str.tostring(active_range_lookback) + " bars"

    // -------------------------
    // Current Price
    // -------------------------
    line.set_color(l_basis, c_basis)
    line.set_width(l_basis, w_basis)
    line.set_style(l_basis, s_basis)
    label.set_textcolor(lbl_basis, c_basis)
    label.set_size(lbl_basis, parsed_size)
    label.set_textalign(lbl_basis, label_align)

    if show_basis and not na(range_start) and not na(anchor_price)
        line.set_xy1(l_basis, range_start, anchor_price)
        line.set_xy2(l_basis, timenow, anchor_price)
        if show_desc or show_price
            label.set_xy(lbl_basis, range_label_x_pos, anchor_price)
            label.set_text(lbl_basis, get_label_text(show_desc, "Current Price [" + tf_label + "]", show_price, anchor_price))
        else
            label.set_xy(lbl_basis, na, na)
    else
        line.set_xy1(l_basis, na, na)
        line.set_xy2(l_basis, na, na)
        label.set_xy(lbl_basis, na, na)

    // -------------------------
    // Min range
    // -------------------------
    line.set_color(l_min_hi, c_upper)
    line.set_width(l_min_hi, w_upper)
    line.set_style(l_min_hi, s_upper)
    label.set_textcolor(lbl_min_hi, c_upper)
    label.set_size(lbl_min_hi, parsed_size)
    label.set_textalign(lbl_min_hi, label_align)

    if show_range_min and show_upper and not na(range_start) and not na(val_min_hi)
        line.set_xy1(l_min_hi, range_start, val_min_hi)
        line.set_xy2(l_min_hi, timenow, val_min_hi)
        if show_desc or show_price
            label.set_xy(lbl_min_hi, range_label_x_pos, val_min_hi)
            label.set_text(lbl_min_hi, get_label_text(show_desc, "Range Upper [" + tf_label + " Min TR, " + lookback_text + "]", show_price, val_min_hi))
        else
            label.set_xy(lbl_min_hi, na, na)
    else
        line.set_xy1(l_min_hi, na, na)
        line.set_xy2(l_min_hi, na, na)
        label.set_xy(lbl_min_hi, na, na)

    line.set_color(l_min_lo, c_lower)
    line.set_width(l_min_lo, w_lower)
    line.set_style(l_min_lo, s_lower)
    label.set_textcolor(lbl_min_lo, c_lower)
    label.set_size(lbl_min_lo, parsed_size)
    label.set_textalign(lbl_min_lo, label_align)

    if show_range_min and show_lower and not na(range_start) and not na(val_min_lo)
        line.set_xy1(l_min_lo, range_start, val_min_lo)
        line.set_xy2(l_min_lo, timenow, val_min_lo)
        if show_desc or show_price
            label.set_xy(lbl_min_lo, range_label_x_pos, val_min_lo)
            label.set_text(lbl_min_lo, get_label_text(show_desc, "Range Lower [" + tf_label + " Min TR, " + lookback_text + "]", show_price, val_min_lo))
        else
            label.set_xy(lbl_min_lo, na, na)
    else
        line.set_xy1(l_min_lo, na, na)
        line.set_xy2(l_min_lo, na, na)
        label.set_xy(lbl_min_lo, na, na)

    // -------------------------
    // Average range
    // -------------------------
    line.set_color(l_avg_hi, c_upper)
    line.set_width(l_avg_hi, w_upper)
    line.set_style(l_avg_hi, s_upper)
    label.set_textcolor(lbl_avg_hi, c_upper)
    label.set_size(lbl_avg_hi, parsed_size)
    label.set_textalign(lbl_avg_hi, label_align)

    if show_range_avg and show_upper and not na(range_start) and not na(val_avg_hi)
        line.set_xy1(l_avg_hi, range_start, val_avg_hi)
        line.set_xy2(l_avg_hi, timenow, val_avg_hi)
        if show_desc or show_price
            label.set_xy(lbl_avg_hi, range_label_x_pos, val_avg_hi)
            label.set_text(lbl_avg_hi, get_label_text(show_desc, "Range Upper [" + tf_label + " Avg TR, " + lookback_text + "]", show_price, val_avg_hi))
        else
            label.set_xy(lbl_avg_hi, na, na)
    else
        line.set_xy1(l_avg_hi, na, na)
        line.set_xy2(l_avg_hi, na, na)
        label.set_xy(lbl_avg_hi, na, na)

    line.set_color(l_avg_lo, c_lower)
    line.set_width(l_avg_lo, w_lower)
    line.set_style(l_avg_lo, s_lower)
    label.set_textcolor(lbl_avg_lo, c_lower)
    label.set_size(lbl_avg_lo, parsed_size)
    label.set_textalign(lbl_avg_lo, label_align)

    if show_range_avg and show_lower and not na(range_start) and not na(val_avg_lo)
        line.set_xy1(l_avg_lo, range_start, val_avg_lo)
        line.set_xy2(l_avg_lo, timenow, val_avg_lo)
        if show_desc or show_price
            label.set_xy(lbl_avg_lo, range_label_x_pos, val_avg_lo)
            label.set_text(lbl_avg_lo, get_label_text(show_desc, "Range Lower [" + tf_label + " Avg TR, " + lookback_text + "]", show_price, val_avg_lo))
        else
            label.set_xy(lbl_avg_lo, na, na)
    else
        line.set_xy1(l_avg_lo, na, na)
        line.set_xy2(l_avg_lo, na, na)
        label.set_xy(lbl_avg_lo, na, na)

    // -------------------------
    // 90th-percentile range
    // -------------------------
    line.set_color(l_p90_hi, c_upper)
    line.set_width(l_p90_hi, w_upper)
    line.set_style(l_p90_hi, s_upper)
    label.set_textcolor(lbl_p90_hi, c_upper)
    label.set_size(lbl_p90_hi, parsed_size)
    label.set_textalign(lbl_p90_hi, label_align)

    if show_range_p90 and show_upper and not na(range_start) and not na(val_p90_hi)
        line.set_xy1(l_p90_hi, range_start, val_p90_hi)
        line.set_xy2(l_p90_hi, timenow, val_p90_hi)
        if show_desc or show_price
            label.set_xy(lbl_p90_hi, range_label_x_pos, val_p90_hi)
            label.set_text(lbl_p90_hi, get_label_text(show_desc, "Range Upper [" + tf_label + " P90 TR, " + lookback_text + "]", show_price, val_p90_hi))
        else
            label.set_xy(lbl_p90_hi, na, na)
    else
        line.set_xy1(l_p90_hi, na, na)
        line.set_xy2(l_p90_hi, na, na)
        label.set_xy(lbl_p90_hi, na, na)

    line.set_color(l_p90_lo, c_lower)
    line.set_width(l_p90_lo, w_lower)
    line.set_style(l_p90_lo, s_lower)
    label.set_textcolor(lbl_p90_lo, c_lower)
    label.set_size(lbl_p90_lo, parsed_size)
    label.set_textalign(lbl_p90_lo, label_align)

    if show_range_p90 and show_lower and not na(range_start) and not na(val_p90_lo)
        line.set_xy1(l_p90_lo, range_start, val_p90_lo)
        line.set_xy2(l_p90_lo, timenow, val_p90_lo)
        if show_desc or show_price
            label.set_xy(lbl_p90_lo, range_label_x_pos, val_p90_lo)
            label.set_text(lbl_p90_lo, get_label_text(show_desc, "Range Lower [" + tf_label + " P90 TR, " + lookback_text + "]", show_price, val_p90_lo))
        else
            label.set_xy(lbl_p90_lo, na, na)
    else
        line.set_xy1(l_p90_lo, na, na)
        line.set_xy2(l_p90_lo, na, na)
        label.set_xy(lbl_p90_lo, na, na)

    // -------------------------
    // Max range
    // -------------------------
    line.set_color(l_max_hi, c_upper)
    line.set_width(l_max_hi, w_upper)
    line.set_style(l_max_hi, s_upper)
    label.set_textcolor(lbl_max_hi, c_upper)
    label.set_size(lbl_max_hi, parsed_size)
    label.set_textalign(lbl_max_hi, label_align)

    if show_range_max and show_upper and not na(range_start) and not na(val_max_hi)
        line.set_xy1(l_max_hi, range_start, val_max_hi)
        line.set_xy2(l_max_hi, timenow, val_max_hi)
        if show_desc or show_price
            label.set_xy(lbl_max_hi, range_label_x_pos, val_max_hi)
            label.set_text(lbl_max_hi, get_label_text(show_desc, "Range Upper [" + tf_label + " Max TR, " + lookback_text + "]", show_price, val_max_hi))
        else
            label.set_xy(lbl_max_hi, na, na)
    else
        line.set_xy1(l_max_hi, na, na)
        line.set_xy2(l_max_hi, na, na)
        label.set_xy(lbl_max_hi, na, na)

    line.set_color(l_max_lo, c_lower)
    line.set_width(l_max_lo, w_lower)
    line.set_style(l_max_lo, s_lower)
    label.set_textcolor(lbl_max_lo, c_lower)
    label.set_size(lbl_max_lo, parsed_size)
    label.set_textalign(lbl_max_lo, label_align)

    if show_range_max and show_lower and not na(range_start) and not na(val_max_lo)
        line.set_xy1(l_max_lo, range_start, val_max_lo)
        line.set_xy2(l_max_lo, timenow, val_max_lo)
        if show_desc or show_price
            label.set_xy(lbl_max_lo, range_label_x_pos, val_max_lo)
            label.set_text(lbl_max_lo, get_label_text(show_desc, "Range Lower [" + tf_label + " Max TR, " + lookback_text + "]", show_price, val_max_lo))
        else
            label.set_xy(lbl_max_lo, na, na)
    else
        line.set_xy1(l_max_lo, na, na)
        line.set_xy2(l_max_lo, na, na)
        label.set_xy(lbl_max_lo, na, na)
